# ==============================================================================
# .gitignore — Smarkee
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Segurança e Credenciais (Prioridade Máxima)
# ------------------------------------------------------------------------------
# Arquivos de ambiente e segredos locais
.env
.env.*
!.env.example
!.env.template
!infrastructure/dev/**/.env

# Chaves privadas, certificados e keystores
*.pem
*.key
*.pkcs12
*.p12
*.pfx
*.keystore
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub

# Credenciais de nuvem, APIs e tokens
credentials
credentials.json
client_secrets.json
service-account*.json
*.token
.netrc

# Acesso Kubernetes e Cloud
kubeconfig
*kubeconfig*.yaml
*kubeconfig*.yml

# Terraform / OpenTofu - segredos e estado sensível
*.tfvars
*.tfvars.json
*.tfstate
*.tfstate.*
!*.example.tfvars

# ------------------------------------------------------------------------------
# 2. Logs, Dumps e Diagnósticos
# ------------------------------------------------------------------------------
*.log
logs/
*.dump
*.dmp
*.sql.dump
*.stackdump
*.pid
*.pid.lock

# ------------------------------------------------------------------------------
# 3. Arquivos Temporários e Cache
# ------------------------------------------------------------------------------
tmp/
temp/
*.tmp
*.temp
*.bak
*.swp
*.swo
*~
.cache/
.workspace/
.journal/

# ------------------------------------------------------------------------------
# 4. Sistemas Operacionais
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# Linux
.directory
.Trash-*
.fuse_hidden*

# ------------------------------------------------------------------------------
# 5. Editores e IDEs
# ------------------------------------------------------------------------------
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/
*.code-workspace

# JetBrains / IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr

# Vim / Emacs
[._]*.s[a-v][a-z]
[._]*.un~
Session.vim
.#*

# ------------------------------------------------------------------------------
# 6. Runtimes, Dependências e Artefatos de Build
# ------------------------------------------------------------------------------
# Node.js / TypeScript
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
dist/
build/
out/
.tsbuildinfo
.next/
.turbo/

# Go
bin/
*.test
*.out
*.exe
*.dll
*.so
*.dylib

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Rust
target/

# Terraform / OpenTofu (plugins e diretório local)
.terraform/
.terraform.tfstate.lock.info

# Containers
.docker/

# ------------------------------------------------------------------------------
# 7. Testes e Cobertura de Código
# ------------------------------------------------------------------------------
coverage/
.nyc_output/
*.lcov
*.coverage
