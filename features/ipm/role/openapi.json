          "conditions": {
            "items": {
              "$ref": "#/components/schemas/Condition"
            },
            "maxItems": 32,
            "title": "Conditions",
            "type": "array"
          },
          "createdAt": {
            "format": "date-time",
            "title": "Createdat",
            "type": "string"
          },
          "desired": {
            "$ref": "#/components/schemas/RoleDesiredView"
          },
          "desiredGeneration": {
            "maximum": 9007199254740991.0,
            "minimum": 1.0,
            "title": "Desiredgeneration",
            "type": "integer"
          },
          "observed": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RoleObservedView"
              },
              {
                "type": "null"
              }
            ],
            "title": "RoleObservedView"
          },
          "phase": {
            "$ref": "#/components/schemas/Phase"
          },
          "resourceId": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-z0-9]([a-z0-9-]{0,126}[a-z0-9])?$",
            "title": "Resourceid",
            "type": "string"
          },
          "resourceVersion": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9-]+$",
            "title": "Resourceversion",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "title": "Updatedat",
            "type": "string"
          }
        },
        "required": [
          "resourceId",
          "resourceVersion",
          "desiredGeneration",
          "phase",
          "conditions",
          "desired",
          "createdAt",
          "updatedAt"
        ],
        "title": "Role",
        "type": "object"
      },
      "RoleCreateRequest": {
        "additionalProperties": false,
        "description": "Corpo de POST /v1/ipm/roles. O Receiver atribui resourceId, operationId, requestDigest e requestedBy, e o Manager atribui deletionProtection = true.",
