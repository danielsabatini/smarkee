            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Deletionprotection"
          },
          "description": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
            "title": "Description",
            "type": "string"
          },
          "lifecycle": {
            "$ref": "#/components/schemas/Lifecycle"
