          "name": {
            "maxLength": 128,
            "minLength": 3,
            "pattern": "^[a-z][a-z0-9]*\\.[a-z][a-zA-Z0-9]*$",
            "title": "Name",
            "type": "string"
          },
          "permissions": {
            "items": {
              "$ref": "#/components/schemas/Permission"
            },
            "maxItems": 64,
            "minItems": 1,
            "title": "Permissions",
            "type": "array"
