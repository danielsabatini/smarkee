erDiagram
    ROLE ||--o{ ROLE_OPERATION : "resource_id"
    ROLE ||--o{ ROLE_OUTBOX : "resource_id"
    ROLE ||--o{ ROLE_ACTION_RESULT : "resource_id"

    ROLE {
        text resource_id PK "UUIDv7 do Receiver"
        text schema_version
        text lifecycle "present ou absent"
        text reconciliation "active ou suspended"
        jsonb desired "intenção: key, displayName, description, permissions e deletionProtection"
        bigint desired_generation
        bigint resource_version
        jsonb observed "key, displayName, description, permissions e deletionProtection lidos do estado"
        text presence "present, absent ou unknown"
        timestamptz observed_at
        text phase "Pending, Reconciling, Ready, Failed, Deleting"
        jsonb conditions
        int failure_count
        bigint observed_generation "última geração confirmada pela observação (decisão 0072)"
        timestamptz created_at
        timestamptz updated_at
    }
    ROLE_OPERATION {
        text operation_id PK
        text resource_id
        text operation_type "create, update ou delete"
        bigint desired_generation "nulo quando rejected"
        text requested_by
        text request_digest
        text operation_status "accepted, in_progress, completed, failed, rejected"
        text operation_status_reason "só quando rejected: conflict, validation, protected ou not_found"
        timestamptz completed_at
    }
    ROLE_OUTBOX {
        bigint sequence PK "ordem de publicação"
        text message_id UK "Nats-Msg-Id"
        text resource_id
        text subject
        jsonb payload "desired ou updated, sem publishedAt e publishedBy"
        timestamptz published_at "nulo enquanto pendente"
    }
    ROLE_ACTION_RESULT {
        text action_id PK "dedupe do resultado"
        text resource_id
        bigint desired_generation
        text action_outcome "completed ou failed"
        timestamptz recorded_at
    }
