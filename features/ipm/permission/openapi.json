{
  "components": {
    "schemas": {
      "Condition": {
        "additionalProperties": false,
        "description": "Fato consolidado do recurso (RESOURCE-CONTROL-LOOP.md, Conditions). Mantida pelo Manager.",
        "properties": {
          "lastTransitionAt": {
            "format": "date-time",
            "title": "Lasttransitionat",
            "type": "string"
          },
          "message": {
            "anyOf": [
              {
                "maxLength": 4096,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          },
          "observedGeneration": {
            "anyOf": [
              {
                "maximum": 9007199254740991.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Observedgeneration"
          },
          "reason": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Z][A-Za-z0-9]*$",
            "title": "Reason",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/ConditionStatus"
          },
          "type": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Z][A-Za-z0-9]*$",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "status",
          "reason",
          "lastTransitionAt"
        ],
        "title": "Condition",
        "type": "object"
      },
      "ConditionStatus": {
        "enum": [
          "True",
          "False",
          "Unknown"
        ],
        "title": "ConditionStatus",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Lifecycle": {
        "description": "Intenção de existência, em desired.",
        "enum": [
          "present",
          "absent"
        ],
        "title": "Lifecycle",
        "type": "string"
      },
      "Permission": {
        "additionalProperties": false,
        "description": "Visão consolidada da Permission (ipm.permission) exposta pelo Receiver (GET). Não expõe campos internos do SSOT (failureCount, requestedBy).",
        "properties": {
          "conditions": {
            "items": {
              "$ref": "#/components/schemas/Condition"
            },
            "maxItems": 32,
            "title": "Conditions",
            "type": "array"
          },
          "createdAt": {
            "format": "date-time",
            "title": "Createdat",
            "type": "string"
          },
          "desired": {
            "$ref": "#/components/schemas/PermissionDesiredView"
          },
          "desiredGeneration": {
            "maximum": 9007199254740991.0,
            "minimum": 1.0,
            "title": "Desiredgeneration",
            "type": "integer"
          },
          "observed": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PermissionObservedView"
              },
              {
                "type": "null"
              }
            ],
            "title": "PermissionObservedView"
          },
          "observedGeneration": {
            "anyOf": [
              {
                "maximum": 9007199254740991.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Observedgeneration"
          },
          "phase": {
            "$ref": "#/components/schemas/Phase"
          },
          "resourceId": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-z0-9]([a-z0-9-]{0,126}[a-z0-9])?$",
            "title": "Resourceid",
            "type": "string"
          },
          "resourceVersion": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9-]+$",
            "title": "Resourceversion",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "title": "Updatedat",
            "type": "string"
          }
        },
        "required": [
          "resourceId",
          "resourceVersion",
          "desiredGeneration",
          "phase",
          "conditions",
          "desired",
          "createdAt",
          "updatedAt"
        ],
        "title": "Permission",
        "type": "object"
      },
      "PermissionCreateRequest": {
        "additionalProperties": false,
        "description": "Corpo de POST /v1/ipm/permissions. O Receiver atribui resourceId, operationId, requestDigest e requestedBy, e o Manager atribui deletionProtection = true.",
        "properties": {
          "description": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
            "title": "Description",
            "type": "string"
          },
          "grantable": {
            "title": "Grantable",
            "type": "boolean"
          },
          "name": {
            "maxLength": 128,
            "minLength": 5,
            "pattern": "^[a-z][a-z0-9]*\\.[a-z][a-z0-9]*\\.[a-z][a-z0-9]*$",
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "description",
          "grantable"
        ],
        "title": "PermissionCreateRequest",
        "type": "object"
      },
      "PermissionDesiredView": {
        "additionalProperties": false,
        "properties": {
          "deletionProtection": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Deletionprotection"
          },
          "description": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
            "title": "Description",
            "type": "string"
          },
          "grantable": {
            "title": "Grantable",
            "type": "boolean"
          },
          "lifecycle": {
            "$ref": "#/components/schemas/Lifecycle"
          },
          "name": {
            "maxLength": 128,
            "minLength": 5,
            "pattern": "^[a-z][a-z0-9]*\\.[a-z][a-z0-9]*\\.[a-z][a-z0-9]*$",
            "title": "Name",
            "type": "string"
          },
          "reconciliation": {
            "$ref": "#/components/schemas/Reconciliation"
          }
        },
        "required": [
          "lifecycle",
          "reconciliation",
          "name",
          "description",
          "grantable"
        ],
        "title": "PermissionDesiredView",
        "type": "object"
      },
      "PermissionList": {
        "additionalProperties": false,
        "description": "Resposta de GET /v1/ipm/permissions: página ordenada por resourceId das Permissions da plataforma. nextCursor ausente indica a última página.",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Permission"
            },
            "maxItems": 200,
            "title": "Items",
            "type": "array"
          },
          "nextCursor": {
            "anyOf": [
              {
                "maxLength": 512,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9_-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Nextcursor"
          }
        },
        "required": [
          "items"
        ],
        "title": "PermissionList",
        "type": "object"
      },
      "PermissionObservedView": {
        "additionalProperties": false,
        "description": "Última observação no projeto roles-<módulo> do Zitadel; ausente antes da primeira.",
        "properties": {
          "description": {
            "anyOf": [
              {
                "maxLength": 256,
                "minLength": 1,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "group": {
            "anyOf": [
              {
                "maxLength": 64,
                "minLength": 2,
                "pattern": "^[a-z][a-z0-9]*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Group"
          },
          "name": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 5,
                "pattern": "^[a-z][a-z0-9]*\\.[a-z][a-z0-9]*\\.[a-z][a-z0-9]*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "observedAt": {
            "format": "date-time",
            "title": "Observedat",
            "type": "string"
          },
          "presence": {
            "$ref": "#/components/schemas/Presence"
          }
        },
        "required": [
          "presence",
          "observedAt"
        ],
        "title": "PermissionObservedView",
        "type": "object"
      },
      "PermissionUpdateRequest": {
        "additionalProperties": false,
        "description": "Corpo de PATCH /v1/ipm/permissions/{resourceId}. resourceVersion é a versão lida; pelo menos um campo deve ser alterado. name não é aceito porque é imutável.",
        "properties": {
          "deletionProtection": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Deletionprotection"
          },
          "description": {
            "anyOf": [
              {
                "maxLength": 256,
                "minLength": 1,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "grantable": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Grantable"
          },
          "reconciliation": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Reconciliation"
              },
              {
                "type": "null"
              }
            ]
          },
          "resourceVersion": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9-]+$",
            "title": "Resourceversion",
            "type": "string"
          }
        },
        "required": [
          "resourceVersion"
        ],
        "title": "PermissionUpdateRequest",
        "type": "object"
      },
      "Phase": {
        "description": "Fase consolidada do recurso (RESOURCE-CONTROL-LOOP.md, Lifecycle).",
        "enum": [
          "Pending",
          "Reconciling",
          "Ready",
          "Failed",
          "Deleting"
        ],
        "title": "Phase",
        "type": "string"
      },
      "Presence": {
        "description": "Resultado da observação, no envelope de observed. unknown nunca é tratado como absent.",
        "enum": [
          "present",
          "absent",
          "unknown"
        ],
        "title": "Presence",
        "type": "string"
      },
      "Reconciliation": {
        "description": "Controle da reconciliação, em desired. Quando suspended, o Reconciler não decide.",
        "enum": [
          "active",
          "suspended"
        ],
        "title": "Reconciliation",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "smarkee ipm permission api",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "health_live_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Live Health Live Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health Live"
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "health_ready_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health Ready"
      }
    },
    "/health/startup": {
      "get": {
        "operationId": "health_startup_health_startup_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Startup Health Startup Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health Startup"
      }
    },
    "/v1/ipm/permissions": {
      "get": {
        "operationId": "list_permissions_v1_ipm_permissions_get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 200,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "after",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 128,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "After"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PermissionList"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Permissions"
      },
      "post": {
        "operationId": "create_permission_v1_ipm_permissions_post",
        "parameters": [
          {
            "in": "header",
            "name": "idempotency-key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PermissionCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Permission"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Permission"
      }
    },
    "/v1/ipm/permissions/{permission_id}": {
      "delete": {
        "operationId": "delete_permission_v1_ipm_permissions__permission_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "permission_id",
            "required": true,
            "schema": {
              "title": "Permission Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "resourceVersion",
            "required": true,
            "schema": {
              "pattern": "^[0-9]{1,18}$",
              "title": "Resourceversion",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "idempotency-key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Idempotency-Key"
            }
          }
        ],
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Permission"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Delete Permission"
      },
      "get": {
        "operationId": "get_permission_v1_ipm_permissions__permission_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "permission_id",
            "required": true,
            "schema": {
              "title": "Permission Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Permission"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Permission"
      },
      "patch": {
        "operationId": "update_permission_v1_ipm_permissions__permission_id__patch",
        "parameters": [
          {
            "in": "path",
            "name": "permission_id",
            "required": true,
            "schema": {
              "title": "Permission Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "idempotency-key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PermissionUpdateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Permission"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Update Permission"
      }
    }
  }
}
