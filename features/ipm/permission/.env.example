# Componentes ipm-permission (receiver, manager, publisher, reconciler, observer e executor). Copie para .env (fora do git) e preencha o
# que está vazio.

# Senhas dos papéis de login do SSOT. Em dev são triviais e iguais ao nome do papel
# (infrastructure/dev/database/bootstrap/ipm.sql). Em stg e prd, vêm da gestão de segredos.
IPM_PERMISSION_RECEIVER_DATABASE_PASSWORD=ipm_permission_receiver_login
IPM_PERMISSION_MANAGER_DATABASE_PASSWORD=ipm_permission_manager_login
IPM_PERMISSION_PUBLISHER_DATABASE_PASSWORD=ipm_permission_publisher_login

# Obrigatório. A mesma SMARKEE_MESSAGING_PASSWORD de messaging/.env (em dev, um único usuário no NATS).
IPM_PERMISSION_RECEIVER_MESSAGING_PASSWORD=
IPM_PERMISSION_MANAGER_MESSAGING_PASSWORD=
IPM_PERMISSION_PUBLISHER_MESSAGING_PASSWORD=
IPM_PERMISSION_RECONCILER_MESSAGING_PASSWORD=

# Obrigatório. ID do projeto `roles-ipm` (organização `core` do Zitadel): é a audience dos tokens.
IPM_PERMISSION_RECEIVER_AUTH_AUDIENCE=

# Observer e Executor: senha do NATS (a mesma SMARKEE_MESSAGING_PASSWORD de messaging/.env).
IPM_PERMISSION_OBSERVER_MESSAGING_PASSWORD=
IPM_PERMISSION_EXECUTOR_MESSAGING_PASSWORD=

# Opcionais (têm default no compose.yaml; descomente só para mudar).
# Imagem única da feature, construída localmente (decisão 0063).
# IPM_PERMISSION_IMAGE=smarkee-ipm-permission:dev
# Limite de CPU de cada um dos 6 papéis.
# IPM_PERMISSION_COMPONENT_CPUS=0.5
# Limite de memória de cada um dos 6 papéis.
# IPM_PERMISSION_COMPONENT_MEMORY=256M
# Limite de CPU do telemeter da feature.
# IPM_PERMISSION_TELEMETER_CPUS=0.25
# Limite de memória do telemeter da feature.
# IPM_PERMISSION_TELEMETER_MEMORY=192M
# Ambiente informado à telemetria (dev, stg, prd).
# SMARKEE_ENVIRONMENT=dev
# Imagem do coletor, a mesma da infraestrutura.
# SMARKEE_TELEMETRY_IMAGE_VERSION=otel/opentelemetry-collector-contrib:0.163.1
# Imagem do cliente psql (infrastructure/tools).
# SMARKEE_DATABASE_CLIENT_IMAGE=smarkee-psql-client:dev
# Imagem da CLI nats (infrastructure/tools).
# SMARKEE_MESSAGING_CLIENT_IMAGE=smarkee-nats-client:dev
# Usuário do NATS (o mesmo de messaging/.env).
# SMARKEE_MESSAGING_USER=smarkee

# Execução local (fora do Docker): `uv run --env-file .env <comando>` contra as portas publicadas pela
# infraestrutura. O ambiente vence o config.toml, e o compose só repassa as variáveis que lista, então
# estas linhas não afetam os contêineres. Descomente e ajuste por papel (exemplo: receiver).
# IPM_PERMISSION_RECEIVER_DATABASE_HOST=localhost
# IPM_PERMISSION_RECEIVER_DATABASE_PORT=5432
# IPM_PERMISSION_RECEIVER_DATABASE_NAME=smarkee
# IPM_PERMISSION_RECEIVER_DATABASE_USER=ipm_permission_receiver_login
# IPM_PERMISSION_RECEIVER_MESSAGING_URL=nats://localhost:4222
# IPM_PERMISSION_RECEIVER_MESSAGING_USER=smarkee
