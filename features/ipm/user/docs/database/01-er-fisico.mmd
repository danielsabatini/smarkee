erDiagram
    USER ||--o{ USER_OPERATION : "resource_id"
    USER ||--o{ USER_OUTBOX : "resource_id"
    USER ||--o{ USER_ACTION_RESULT : "resource_id"

    USER {
        text resource_id PK "UUIDv7 do Receiver; é o ID do usuário no Zitadel"
        text schema_version
        text lifecycle "present ou absent"
        text reconciliation "active ou suspended"
        jsonb desired "organizationId, roles, deletionProtection e, enquanto present, givenName, familyName e email"
        bigint desired_generation
        bigint resource_version
        jsonb observed "emailVerified, userState, roles e deletionProtection lidos do Zitadel"
        text presence "present, absent ou unknown"
        timestamptz observed_at
        text phase "Pending, Reconciling, Ready, Failed, Deleting"
        jsonb conditions
        int failure_count
        bigint observed_generation "última geração confirmada pela observação (decisão 0072)"
        timestamptz created_at
        timestamptz updated_at
    }
    USER_OPERATION {
        text operation_id PK
        text resource_id
        text operation_type "create, update ou delete"
        bigint desired_generation "nulo quando rejected"
        text requested_by
        text request_digest
        text operation_status "accepted, in_progress, completed, failed, rejected"
        text operation_status_reason "só quando rejected: conflict, validation, not_found ou protected"
        timestamptz completed_at
    }
    USER_OUTBOX {
        bigint sequence PK "ordem de publicação"
        text message_id UK "Nats-Msg-Id"
        text resource_id
        text subject
        jsonb payload "desired ou updated, sem publishedAt e publishedBy"
        text traceparent "contexto de trace da origem (decisão 0055)"
        timestamptz published_at "nulo enquanto pendente"
    }
    USER_ACTION_RESULT {
        text action_id PK "dedupe do resultado"
        text resource_id
        bigint desired_generation
        text action_outcome "completed ou failed"
        timestamptz recorded_at
    }
