# Componentes ipm-serviceaccount (api, publisher e controller). Copie para .env (fora do git) e preencha o
# que está vazio.

# Senhas dos papéis de login do SSOT. Em dev são triviais e iguais ao nome do papel
# (infrastructure/dev/database/bootstrap/ipm.sql). Em stg e prd, vêm da gestão de segredos.
IPM_SERVICEACCOUNT_API_DATABASE_PASSWORD=ipm_serviceaccount_api_login
IPM_SERVICEACCOUNT_PUBLISHER_DATABASE_PASSWORD=ipm_serviceaccount_publisher_login
IPM_SERVICEACCOUNT_CONTROLLER_DATABASE_PASSWORD=ipm_serviceaccount_controller_login

# Obrigatório. A mesma SMARKEE_MESSAGING_PASSWORD de messaging/.env (em dev, um único usuário no NATS).
IPM_SERVICEACCOUNT_API_MESSAGING_PASSWORD=
IPM_SERVICEACCOUNT_PUBLISHER_MESSAGING_PASSWORD=
IPM_SERVICEACCOUNT_CONTROLLER_MESSAGING_PASSWORD=

# Obrigatório. ID do projeto `roles-ipm` (organização `core` do Zitadel): é a audience dos tokens.
IPM_SERVICEACCOUNT_API_AUTH_AUDIENCE=

# Controller: senha do NATS (a mesma SMARKEE_MESSAGING_PASSWORD de messaging/.env).

# Obrigatório. ID do projeto `roles-ipm`: o único em que o Controller concede e lê roles
# (decisão 0094). O mesmo valor de IPM_SERVICEACCOUNT_API_AUTH_AUDIENCE.
IPM_SERVICEACCOUNT_IDENTITY_PROJECT_ID=

# Opcionais (têm default no compose.yaml; descomente só para mudar).
# Imagem única da feature, construída localmente (decisão 0063).
# IPM_SERVICEACCOUNT_IMAGE=smarkee-ipm-serviceaccount:dev
# Limite de CPU de cada um dos 6 papéis.
# IPM_SERVICEACCOUNT_COMPONENT_CPUS=0.5
# Limite de memória de cada um dos 6 papéis.
# IPM_SERVICEACCOUNT_COMPONENT_MEMORY=256M
# Limite de CPU do telemeter da feature.
# IPM_SERVICEACCOUNT_TELEMETER_CPUS=0.25
# Limite de memória do telemeter da feature.
# IPM_SERVICEACCOUNT_TELEMETER_MEMORY=192M
# Ambiente informado à telemetria (dev, stg, prd).
# SMARKEE_ENVIRONMENT=dev
# Imagem do coletor, a mesma da infraestrutura.
# SMARKEE_TELEMETRY_IMAGE_VERSION=otel/opentelemetry-collector-contrib:0.163.1
# Imagem do cliente psql (infrastructure/tools).
# SMARKEE_DATABASE_CLIENT_IMAGE=smarkee-psql-client:dev
# Imagem da CLI nats (infrastructure/tools).
# SMARKEE_MESSAGING_CLIENT_IMAGE=smarkee-nats-client:dev
# Usuário do NATS (o mesmo de messaging/.env).
# SMARKEE_MESSAGING_USER=smarkee

# Execução local (fora do Docker): `uv run --env-file .env <comando>` contra as portas publicadas pela
# infraestrutura. O ambiente vence o config.toml, e o compose só repassa as variáveis que lista, então
# estas linhas não afetam os contêineres. Descomente e ajuste por papel (exemplo: api).
# IPM_SERVICEACCOUNT_API_DATABASE_HOST=localhost
# IPM_SERVICEACCOUNT_API_DATABASE_PORT=5432
# IPM_SERVICEACCOUNT_API_DATABASE_NAME=ssot
# IPM_SERVICEACCOUNT_API_DATABASE_USER=ipm_serviceaccount_api_login
# IPM_SERVICEACCOUNT_API_MESSAGING_URL=nats://localhost:4222
# IPM_SERVICEACCOUNT_API_MESSAGING_USER=smarkee
