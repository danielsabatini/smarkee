{
  "components": {
    "schemas": {
      "ApiAcceptedResponse": {
        "additionalProperties": false,
        "description": "Resposta das escritas assíncronas (POST, PATCH, DELETE): o pedido foi publicado, não aplicado (RESOURCE-CONTROL-LOOP.md, Interface HTTP).",
        "properties": {
          "operationId": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-z0-9]([a-z0-9-]{0,126}[a-z0-9])?$",
            "title": "Operationid",
            "type": "string"
          },
          "resourceId": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-z0-9]([a-z0-9-]{0,126}[a-z0-9])?$",
            "title": "Resourceid",
            "type": "string"
          }
        },
        "required": [
          "resourceId",
          "operationId"
        ],
        "title": "ApiAcceptedResponse",
        "type": "object"
      },
      "Condition": {
        "additionalProperties": false,
        "description": "Fato consolidado do recurso (RESOURCE-CONTROL-LOOP.md, Conditions). Mantida pelo Manager.",
        "properties": {
          "lastTransitionAt": {
            "format": "date-time",
            "title": "Lasttransitionat",
            "type": "string"
          },
          "message": {
            "anyOf": [
              {
                "maxLength": 4096,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          },
          "observedGeneration": {
            "anyOf": [
              {
                "maximum": 9007199254740991.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Observedgeneration"
          },
          "reason": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Z][A-Za-z0-9]*$",
            "title": "Reason",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/ConditionStatus"
          },
          "type": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Z][A-Za-z0-9]*$",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "status",
          "reason",
          "lastTransitionAt"
        ],
        "title": "Condition",
        "type": "object"
      },
      "ConditionStatus": {
        "enum": [
          "True",
          "False",
          "Unknown"
        ],
        "title": "ConditionStatus",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Lifecycle": {
        "description": "Intenção de existência, em desired.",
        "enum": [
          "present",
          "absent"
        ],
        "title": "Lifecycle",
        "type": "string"
      },
      "Operation": {
        "additionalProperties": false,
        "description": "Acompanhamento de uma solicitação assíncrona, exposto por GET /v1/operations/{operationId} (SSOT.md, Operation).",
        "properties": {
          "completedAt": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completedat"
          },
          "createdAt": {
            "format": "date-time",
            "title": "Createdat",
            "type": "string"
          },
          "desiredGeneration": {
            "anyOf": [
              {
                "maximum": 9007199254740991.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Desiredgeneration"
          },
          "module": {
            "maxLength": 63,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9-]*$",
            "title": "Module",
            "type": "string"
          },
          "operationId": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-z0-9]([a-z0-9-]{0,126}[a-z0-9])?$",
            "title": "Operationid",
            "type": "string"
          },
          "operationStatus": {
            "$ref": "#/components/schemas/OperationStatus"
          },
          "operationStatusReason": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/OperationStatusReason"
              },
              {
                "type": "null"
              }
            ],
            "title": "OperationStatusReason"
          },
          "operationType": {
            "$ref": "#/components/schemas/OperationType"
          },
          "resourceId": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-z0-9]([a-z0-9-]{0,126}[a-z0-9])?$",
            "title": "Resourceid",
            "type": "string"
          },
          "resourceType": {
            "maxLength": 63,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9-]*$",
            "title": "Resourcetype",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "title": "Updatedat",
            "type": "string"
          }
        },
        "required": [
          "operationId",
          "operationType",
          "module",
          "resourceType",
          "resourceId",
          "operationStatus",
          "createdAt",
          "updatedAt"
        ],
        "title": "Operation",
        "type": "object"
      },
      "OperationStatus": {
        "enum": [
          "accepted",
          "in_progress",
          "completed",
          "failed",
          "rejected",
          "superseded"
        ],
        "title": "OperationStatus",
        "type": "string"
      },
      "OperationStatusReason": {
        "description": "Motivo da rejeição; presente somente quando operationStatus é rejected. protected: o recurso tem a proteção contra exclusão ligada (decisão 0043).",
        "enum": [
          "conflict",
          "validation",
          "not_found",
          "protected"
        ],
        "title": "OperationStatusReason",
        "type": "string"
      },
      "OperationType": {
        "enum": [
          "create",
          "update",
          "delete"
        ],
        "title": "OperationType",
        "type": "string"
      },
      "Organization": {
        "additionalProperties": false,
        "description": "Visão consolidada da Organization exposta pelo Receiver (GET). Não expõe o dono (ownerAccountId) nem campos internos do SSOT (failureCount, requestedBy).",
        "properties": {
          "conditions": {
            "items": {
              "$ref": "#/components/schemas/Condition"
            },
            "maxItems": 32,
            "title": "Conditions",
            "type": "array"
          },
          "createdAt": {
            "format": "date-time",
            "title": "Createdat",
            "type": "string"
          },
          "desired": {
            "$ref": "#/components/schemas/OrganizationDesiredView"
          },
          "desiredGeneration": {
            "maximum": 9007199254740991.0,
            "minimum": 1.0,
            "title": "Desiredgeneration",
            "type": "integer"
          },
          "observed": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/OrganizationObservedView"
              },
              {
                "type": "null"
              }
            ],
            "title": "OrganizationObservedView"
          },
          "phase": {
            "$ref": "#/components/schemas/Phase"
          },
          "resourceId": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-z0-9]([a-z0-9-]{0,126}[a-z0-9])?$",
            "title": "Resourceid",
            "type": "string"
          },
          "resourceVersion": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9-]+$",
            "title": "Resourceversion",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "title": "Updatedat",
            "type": "string"
          }
        },
        "required": [
          "resourceId",
          "resourceVersion",
          "desiredGeneration",
          "phase",
          "conditions",
          "desired",
          "createdAt",
          "updatedAt"
        ],
        "title": "Organization",
        "type": "object"
      },
      "OrganizationCreateRequest": {
        "additionalProperties": false,
        "description": "Corpo de POST /v1/ipm/organizations. O Receiver atribui resourceId, operationId, requestDigest e requestedBy, registra platformAccess = granted e o dono (ownerAccountId = solicitante autenticado): uma Organization criada sem acesso à plataforma não tem uso.",
        "properties": {
          "billingAccountId": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[a-z0-9]([a-z0-9-]{0,126}[a-z0-9])?$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Billingaccountid"
          },
          "name": {
            "maxLength": 63,
            "minLength": 1,
            "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$",
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "OrganizationCreateRequest",
        "type": "object"
      },
      "OrganizationDesiredView": {
        "additionalProperties": false,
        "properties": {
          "billingAccountId": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[a-z0-9]([a-z0-9-]{0,126}[a-z0-9])?$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Billingaccountid"
          },
          "deletionProtection": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Deletionprotection"
          },
          "lifecycle": {
            "$ref": "#/components/schemas/Lifecycle"
          },
          "name": {
            "maxLength": 63,
            "minLength": 1,
            "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$",
            "title": "Name",
            "type": "string"
          },
          "platformAccess": {
            "$ref": "#/components/schemas/PlatformAccess"
          },
          "reconciliation": {
            "$ref": "#/components/schemas/Reconciliation"
          }
        },
        "required": [
          "lifecycle",
          "reconciliation",
          "name",
          "platformAccess"
        ],
        "title": "OrganizationDesiredView",
        "type": "object"
      },
      "OrganizationList": {
        "additionalProperties": false,
        "description": "Resposta de GET /v1/ipm/organizations: página ordenada por resourceId, somente das Organizations autorizadas. nextCursor ausente indica a última página.",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Organization"
            },
            "maxItems": 200,
            "title": "Items",
            "type": "array"
          },
          "nextCursor": {
            "anyOf": [
              {
                "maxLength": 512,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9_-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Nextcursor"
          }
        },
        "required": [
          "items"
        ],
        "title": "OrganizationList",
        "type": "object"
      },
      "OrganizationObservedView": {
        "additionalProperties": false,
        "description": "Última observação; ausente antes da primeira.",
