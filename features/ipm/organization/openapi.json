      "OrganizationUpdateRequest": {
        "additionalProperties": false,
        "description": "Corpo de PATCH /v1/ipm/organizations/{resourceId}. resourceVersion é a versão lida; pelo menos um campo deve ser alterado.",
        "properties": {
          "billingAccountId": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 1,
