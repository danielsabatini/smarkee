              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "observedAt": {
            "format": "date-time",
            "title": "Observedat",
            "type": "string"
          },
          "organizationState": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/OrganizationState"
              },
              {
                "type": "null"
              }
            ]
          },
          "platformAccess": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PlatformAccess"
              },
              {
                "type": "null"
              }
            ]
          },
          "presence": {
            "$ref": "#/components/schemas/Presence"
          }
        },
        "required": [
          "presence",
          "observedAt"
        ],
        "title": "OrganizationObservedView",
        "type": "object"
