# Componentes ipm-organization (receiver, manager, publisher, reconciler, observer e executor). Copie para .env (fora do git) e preencha o
# que está vazio.

# Senhas dos papéis de login do SSOT. Em dev são triviais e iguais ao nome do papel
# (infrastructure/dev/database/bootstrap/ipm.sql). Em stg e prd, vêm da gestão de segredos.
IPM_ORGANIZATION_RECEIVER_DATABASE_PASSWORD=ipm_organization_receiver_login
IPM_ORGANIZATION_MANAGER_DATABASE_PASSWORD=ipm_organization_manager_login
IPM_ORGANIZATION_PUBLISHER_DATABASE_PASSWORD=ipm_organization_publisher_login

# Obrigatório. A mesma MESSAGING_PASSWORD de messaging/.env (em dev, um único usuário no NATS).
IPM_ORGANIZATION_RECEIVER_MESSAGING_PASSWORD=
IPM_ORGANIZATION_MANAGER_MESSAGING_PASSWORD=
IPM_ORGANIZATION_PUBLISHER_MESSAGING_PASSWORD=
IPM_ORGANIZATION_RECONCILER_MESSAGING_PASSWORD=
IPM_ORGANIZATION_OBSERVER_MESSAGING_PASSWORD=
IPM_ORGANIZATION_EXECUTOR_MESSAGING_PASSWORD=

# Obrigatório. ID do projeto `roles-ipm` (organização `core` do Zitadel): é a audience dos tokens.
IPM_ORGANIZATION_RECEIVER_AUTH_AUDIENCE=

# Opcionais (têm default no compose.yaml): tags das imagens construídas localmente e das imagens de apoio.
# IPM_ORGANIZATION_IMAGE (imagem única da feature, decisão 0063),
# DATABASE_CLIENT_IMAGE, MESSAGING_CLIENT_IMAGE (imagens de `infrastructure/tools`), MESSAGING_USER

# Execução local (fora do Docker): `uv run --env-file .env <comando>` contra as portas publicadas pela
# infraestrutura. O ambiente vence o config.toml, e o compose só repassa as variáveis que lista, então
# estas linhas não afetam os contêineres. Descomente e ajuste por papel (exemplo: receiver).
# IPM_ORGANIZATION_RECEIVER_DATABASE_HOST=localhost
# IPM_ORGANIZATION_RECEIVER_DATABASE_PORT=5432
# IPM_ORGANIZATION_RECEIVER_DATABASE_NAME=smarkee
# IPM_ORGANIZATION_RECEIVER_DATABASE_USER=ipm_organization_receiver_login
# IPM_ORGANIZATION_RECEIVER_MESSAGING_URL=nats://localhost:4222
# IPM_ORGANIZATION_RECEIVER_MESSAGING_USER=smarkee
