# Componentes ipm-organization (receiver, manager, publisher, reconciler, observer e executor). Copie para .env (fora do git) e preencha o
# que está vazio.

# Senhas dos papéis de login do SSOT. Em dev são triviais e iguais ao nome do papel
# (infrastructure/dev/database/bootstrap/ipm.sql). Em stg e prd, vêm da gestão de segredos.
IPM_ORGANIZATION_RECEIVER_DATABASE_PASSWORD=ipm_organization_receiver_login
IPM_ORGANIZATION_MANAGER_DATABASE_PASSWORD=ipm_organization_manager_login
IPM_ORGANIZATION_PUBLISHER_DATABASE_PASSWORD=ipm_organization_publisher_login

# Obrigatório. A mesma NATS_PASSWORD de messaging/.env (em dev, um único usuário no NATS).
IPM_ORGANIZATION_RECEIVER_NATS_PASSWORD=
IPM_ORGANIZATION_MANAGER_NATS_PASSWORD=
IPM_ORGANIZATION_PUBLISHER_NATS_PASSWORD=
IPM_ORGANIZATION_RECONCILER_NATS_PASSWORD=
IPM_ORGANIZATION_OBSERVER_NATS_PASSWORD=
IPM_ORGANIZATION_EXECUTOR_NATS_PASSWORD=

# Obrigatório. ID do projeto `roles-ipm` (organização `core` do Zitadel): é a audience dos tokens.
IPM_ORGANIZATION_RECEIVER_AUTH_AUDIENCE=

# Opcionais (têm default no compose.yaml): tags das imagens construídas localmente e das imagens de apoio.
# IPM_ORGANIZATION_IMAGE (imagem única da feature, decisão 0063),
# POSTGRES_CLIENT_IMAGE, NATS_CLIENT_IMAGE (imagens de `infrastructure/tools`), NATS_USER
