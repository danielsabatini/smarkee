              {
                "maxLength": 4096,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          },
          "observedGeneration": {
            "anyOf": [
              {
                "maximum": 9007199254740991.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Observedgeneration"
          },
          "reason": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Z][A-Za-z0-9]*$",
            "title": "Reason",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/ConditionStatus"
          },
          "type": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Z][A-Za-z0-9]*$",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "status",
          "reason",
          "lastTransitionAt"
