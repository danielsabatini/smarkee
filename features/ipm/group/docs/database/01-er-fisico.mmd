erDiagram
    GROUP ||--o{ GROUP_OPERATION : "resource_id"
    GROUP ||--o{ GROUP_OUTBOX : "resource_id"
    GROUP ||--o{ GROUP_ACTION_RESULT : "resource_id"
    PLATFORM_GROUP ||--o{ PLATFORM_GROUP_ROLE : "group_id"

    GROUP {
        text resource_id PK "UUIDv7 do Receiver (banco ssot)"
        text schema_version
        text lifecycle "present ou absent"
        text reconciliation "active ou suspended"
        jsonb desired "intenção: organizationId, name, description, roles e deletionProtection"
        bigint desired_generation
        bigint resource_version
        jsonb observed "name, description, roles e deletionProtection lidos do estado"
        text presence "present, absent ou unknown"
        timestamptz observed_at
        text phase "Pending, Reconciling, Ready, Failed, Deleting"
        jsonb conditions
        int failure_count
        bigint observed_generation "última geração confirmada pela observação (decisão 0072)"
        timestamptz created_at
        timestamptz updated_at
    }
    GROUP_OPERATION {
        text operation_id PK
        text resource_id
        text operation_type "create, update ou delete"
        bigint desired_generation
        text request_digest
        text idempotency_key
        text requested_by
        text operation_status "accepted, in_progress, completed, rejected"
        text operation_status_reason "conflict, validation, quota_exceeded, protected, not_found"
        timestamptz created_at
        timestamptz updated_at
        timestamptz completed_at
    }
    GROUP_OUTBOX {
        bigint sequence PK
        text message_id UK "vira Nats-Msg-Id"
        text resource_id
        text subject
        jsonb payload "envelope completo sem publishedAt/publishedBy"
        timestamptz created_at
        timestamptz published_at
    }
    GROUP_ACTION_RESULT {
        text action_id PK
        text resource_id
        text outcome "completed ou failed"
        timestamptz processed_at
    }
    PLATFORM_GROUP {
        text resource_id PK "estado aplicado no banco platform (ipm.group)"
        text organization_id
        text name "único por organization_id"
        text description
        boolean deletion_protection
        timestamptz created_at
        timestamptz updated_at
    }
    PLATFORM_GROUP_ROLE {
        text group_id PK,FK "ipm.group_role (ON DELETE CASCADE)"
        text role_name PK
    }
