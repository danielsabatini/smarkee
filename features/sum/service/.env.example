# Componentes de sum.service (receiver, manager, publisher, reconciler, observer e executor). Copie para .env (fora do git) e preencha o
# que está vazio.

# Senhas dos papéis de login do SSOT. Em dev são triviais e iguais ao nome do papel
# (infrastructure/dev/database/bootstrap/sum.sql). Em stg e prd, vêm da gestão de segredos.
SUM_SERVICE_RECEIVER_DATABASE_PASSWORD=sum_service_receiver_login
SUM_SERVICE_MANAGER_DATABASE_PASSWORD=sum_service_manager_login
SUM_SERVICE_PUBLISHER_DATABASE_PASSWORD=sum_service_publisher_login

# Obrigatório. A mesma SMARKEE_MESSAGING_PASSWORD de messaging/.env (em dev, um único usuário no NATS).
SUM_SERVICE_RECEIVER_MESSAGING_PASSWORD=
SUM_SERVICE_MANAGER_MESSAGING_PASSWORD=
SUM_SERVICE_PUBLISHER_MESSAGING_PASSWORD=
SUM_SERVICE_RECONCILER_MESSAGING_PASSWORD=
SUM_SERVICE_OBSERVER_MESSAGING_PASSWORD=
SUM_SERVICE_EXECUTOR_MESSAGING_PASSWORD=

# Obrigatório. ID do projeto de roles do SUM (`roles-sum`, organização `core` do Zitadel): é a audience dos
# tokens aceitos pelo Receiver.
SUM_SERVICE_RECEIVER_AUTH_AUDIENCE=

# Obrigatórios para Observer e Executor. A organização `register` (usuários) e, por módulo, o projeto de roles
# (JSON; decisão 0032). Hoje só `ipm`, em `roles-ipm`.
SUM_SERVICE_IDENTITY_REGISTER_ORGANIZATION_ID=
SUM_SERVICE_IDENTITY_PROJECT_IDS={"ipm":"<ID de roles-ipm>"}

# Obrigatório. Catálogo de serviços: serviço → roles de ação que o usuário recebe ao ligá-lo (JSON,
# decisão 0033). Os nomes das roles seguem o padrão <módulo>.<tipo>.<ação> e precisam existir no projeto
# de roles do módulo no Zitadel (roles-ipm, para `ipm`).
SUM_SERVICE_MANAGER_CATALOG_ROLES={"ipm":["ipm.organization.create","ipm.organization.delete","ipm.organization.get","ipm.organization.list","ipm.organization.update"]}

# Opcionais (têm default no compose.yaml): tags das imagens construídas localmente e das imagens de apoio.
# SUM_SERVICE_IMAGE (imagem única da feature, decisão 0063), SMARKEE_DATABASE_CLIENT_IMAGE, SMARKEE_MESSAGING_CLIENT_IMAGE, SMARKEE_MESSAGING_USER

# Execução local (fora do Docker): `uv run --env-file .env <comando>` contra as portas publicadas pela
# infraestrutura. O ambiente vence o config.toml, e o compose só repassa as variáveis que lista, então
# estas linhas não afetam os contêineres. Descomente e ajuste por papel (exemplo: receiver).
# SUM_SERVICE_RECEIVER_DATABASE_HOST=localhost
# SUM_SERVICE_RECEIVER_DATABASE_PORT=5432
# SUM_SERVICE_RECEIVER_DATABASE_NAME=smarkee
# SUM_SERVICE_RECEIVER_DATABASE_USER=sum_service_receiver_login
# SUM_SERVICE_RECEIVER_MESSAGING_URL=nats://localhost:4222
# SUM_SERVICE_RECEIVER_MESSAGING_USER=smarkee
