# Componentes sum-service (api, publisher e controller). Copie para .env (fora do git) e preencha o
# que está vazio.

# Senhas dos papéis de login do SSOT. Em dev são triviais e iguais ao nome do papel
# (infrastructure/dev/database/bootstrap/sum.sql). Em stg e prd, vêm da gestão de segredos.
SUM_SERVICE_API_DATABASE_PASSWORD=sum_service_api_login
SUM_SERVICE_PUBLISHER_DATABASE_PASSWORD=sum_service_publisher_login
SUM_SERVICE_CONTROLLER_DATABASE_PASSWORD=sum_service_controller_login

# Obrigatório. A mesma SMARKEE_MESSAGING_PASSWORD de messaging/.env (em dev, um único usuário no NATS).
SUM_SERVICE_API_MESSAGING_PASSWORD=
SUM_SERVICE_PUBLISHER_MESSAGING_PASSWORD=
SUM_SERVICE_CONTROLLER_MESSAGING_PASSWORD=

# Obrigatório. ID do projeto de roles do SUM (`roles-sum`, organização `core` do Zitadel): é a audience dos
# tokens aceitos pela API.
SUM_SERVICE_API_AUTH_AUDIENCE=

# Obrigatórios para o Controller. A organização `register` (usuários) e, por módulo, o projeto de roles
# que ele concede (JSON; decisão 0032).
SUM_SERVICE_IDENTITY_REGISTER_ORGANIZATION_ID=
SUM_SERVICE_IDENTITY_PROJECT_IDS={"ipm":"<ID de roles-ipm>"}

# Obrigatório. Catálogo de serviços: serviço → permissões de ação que o usuário recebe ao ligá-lo (JSON,
# decisão 0033). Os nomes seguem o padrão <módulo>.<tipo>.<ação> e precisam existir no projeto de roles do
# módulo no Zitadel (`roles-ipm` para `ipm`). Usado pela API e pelo Controller.
SUM_SERVICE_CATALOG_PERMISSIONS={"ipm":["ipm.group.bind","ipm.group.create","ipm.group.delete","ipm.group.get","ipm.group.list","ipm.group.update","ipm.organization.create","ipm.organization.delete","ipm.organization.get","ipm.organization.list","ipm.organization.update","ipm.role.bind","ipm.role.create","ipm.role.delete","ipm.role.get","ipm.role.list","ipm.role.update","ipm.serviceaccount.bind","ipm.serviceaccount.create","ipm.serviceaccount.delete","ipm.serviceaccount.get","ipm.serviceaccount.list","ipm.serviceaccount.update","ipm.user.bind","ipm.user.create","ipm.user.delete","ipm.user.get","ipm.user.list","ipm.user.update"]}

# Opcionais (têm default no compose.yaml; descomente só para mudar).
# Imagem única da feature, construída localmente (decisão 0063).
# SUM_SERVICE_IMAGE=smarkee-sum-service:dev
# Limite de CPU de cada um dos papéis.
# SUM_SERVICE_COMPONENT_CPUS=0.5
# Limite de memória de cada um dos papéis.
# SUM_SERVICE_COMPONENT_MEMORY=256M
# Limite de CPU do telemeter da feature.
# SUM_SERVICE_TELEMETER_CPUS=0.25
# Limite de memória do telemeter da feature.
# SUM_SERVICE_TELEMETER_MEMORY=192M
# Ambiente informado à telemetria (dev, stg, prd).
# SMARKEE_ENVIRONMENT=dev
# Imagem do coletor, a mesma da infraestrutura.
# SMARKEE_TELEMETRY_IMAGE_VERSION=otel/opentelemetry-collector-contrib:0.163.1
# Imagem do cliente psql (infrastructure/tools).
# SMARKEE_DATABASE_CLIENT_IMAGE=smarkee-psql-client:dev
# Usuário do NATS (o mesmo de messaging/.env).
# SMARKEE_MESSAGING_USER=smarkee

# Execução local (fora do Docker): `uv run --env-file .env <comando>` contra as portas publicadas pela
# infraestrutura. O ambiente vence o config.toml, e o compose só repassa as variáveis que lista, então
# estas linhas não afetam os contêineres. Descomente e ajuste por papel (exemplo: api).
# SUM_SERVICE_API_DATABASE_HOST=localhost
# SUM_SERVICE_API_DATABASE_PORT=5432
# SUM_SERVICE_API_DATABASE_NAME=ssot
# SUM_SERVICE_API_DATABASE_USER=sum_service_api_login
# SUM_SERVICE_API_MESSAGING_URL=nats://localhost:4222
# SUM_SERVICE_API_MESSAGING_USER=smarkee
