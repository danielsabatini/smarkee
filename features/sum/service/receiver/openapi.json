            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Recurso inexistente ou de outro dono (`NotFound`)."
          }
        },
        "summary": "Read Service"
      }
