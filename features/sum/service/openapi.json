{
  "components": {
    "schemas": {
      "AvailableServicesResponse": {
        "additionalProperties": false,
        "description": "Corpo de GET /v1/sum/services/available: lista os serviços disponíveis no catálogo da plataforma.",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Item"
            },
            "maxItems": 200,
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "AvailableServicesResponse",
        "type": "object"
      },
      "Condition": {
        "additionalProperties": false,
        "description": "Fato consolidado do recurso (RESOURCE-CONTROL-LOOP.md, Conditions). Mantida pelo Manager.",
        "properties": {
          "lastTransitionAt": {
            "format": "date-time",
            "title": "Lasttransitionat",
            "type": "string"
          },
          "message": {
            "anyOf": [
              {
                "maxLength": 4096,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          },
          "observedGeneration": {
            "anyOf": [
              {
                "maximum": 9007199254740991.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Observedgeneration"
          },
          "reason": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Z][A-Za-z0-9]*$",
            "title": "Reason",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/ConditionStatus"
          },
          "type": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Z][A-Za-z0-9]*$",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "status",
          "reason",
          "lastTransitionAt"
        ],
        "title": "Condition",
        "type": "object"
      },
      "ConditionStatus": {
        "enum": [
          "True",
          "False",
          "Unknown"
        ],
        "title": "ConditionStatus",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Item": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "anyOf": [
              {
                "maxLength": 512,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "name": {
            "maxLength": 32,
            "minLength": 2,
            "pattern": "^[a-z][a-z0-9]*$",
            "title": "Name",
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/State"
          },
          "title": {
            "maxLength": 128,
            "minLength": 2,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "name",
          "title",
          "state"
        ],
        "title": "Item",
        "type": "object"
      },
      "Lifecycle": {
        "description": "Intenção de existência, em desired.",
        "enum": [
          "present",
          "absent"
        ],
        "title": "Lifecycle",
        "type": "string"
      },
      "Phase": {
        "description": "Fase consolidada do recurso (RESOURCE-CONTROL-LOOP.md, Lifecycle).",
        "enum": [
          "Pending",
          "Reconciling",
          "Ready",
          "Failed",
          "Deleting"
        ],
        "title": "Phase",
        "type": "string"
      },
      "Reconciliation": {
        "description": "Controle da reconciliação, em desired. Quando suspended, o Reconciler não decide.",
        "enum": [
          "active",
          "suspended"
        ],
        "title": "Reconciliation",
        "type": "string"
      },
      "ServiceCreateRequest": {
        "additionalProperties": false,
        "description": "Corpo de POST /v1/sum/services. O solicitante é o dono da ligação (vem do token, nunca do corpo). A API atribui o resourceId. A ligação é do solicitante: o corpo não escolhe o usuário.",
        "properties": {
          "service": {
            "maxLength": 32,
            "minLength": 2,
            "pattern": "^[a-z][a-z0-9]*$",
            "title": "Service",
            "type": "string"
          }
        },
        "required": [
          "service"
        ],
        "title": "ServiceCreateRequest",
        "type": "object"
      },
      "ServiceDesiredData": {
        "additionalProperties": false,
        "description": "data de desired do SUM: a ligação de um serviço para um usuário. Publicado somente pela API (e pelo Controller ao suspender a reconciliação), a partir do pedido admitido e do catálogo de serviços (decisões 0033 e 0098). Sem dados pessoais: o usuário é referenciado pelo ownerAccountId.",
        "properties": {
          "lifecycle": {
            "$ref": "#/components/schemas/Lifecycle"
          },
          "managedPermissions": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ServicePermission"
                },
                "maxItems": 64,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Managedpermissions"
          },
          "ownerAccountId": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-z0-9]([a-z0-9-]{0,126}[a-z0-9])?$",
            "title": "Owneraccountid",
            "type": "string"
          },
          "reconciliation": {
            "$ref": "#/components/schemas/Reconciliation"
          },
          "service": {
            "maxLength": 32,
            "minLength": 2,
            "pattern": "^[a-z][a-z0-9]*$",
            "title": "Service",
            "type": "string"
          },
          "servicePermissions": {
            "items": {
              "$ref": "#/components/schemas/ServicePermission"
            },
            "maxItems": 64,
            "title": "Servicepermissions",
            "type": "array"
          }
        },
        "required": [
          "lifecycle",
          "reconciliation",
          "ownerAccountId",
          "service",
          "servicePermissions"
        ],
        "title": "ServiceDesiredData",
        "type": "object"
      },
      "ServiceListResponse": {
        "additionalProperties": false,
        "description": "Corpo de GET /v1/sum/services: as ligações do solicitante cujo serviço ele pode ler (permissão sum.<serviço>.get), até o limite pedido.",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ServiceResource"
            },
            "maxItems": 200,
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "ServiceListResponse",
        "type": "object"
      },
      "ServiceObservedData": {
        "additionalProperties": false,
        "description": "data de observed do SUM: as permissões do serviço que o usuário tem hoje, lidas do Zitadel. Vazio quando a ligação está ausente.",
        "properties": {
          "servicePermissions": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ServicePermission"
                },
                "maxItems": 64,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Servicepermissions"
          }
        },
        "title": "ServiceObservedData",
        "type": "object"
      },
      "ServicePermission": {
        "maxLength": 128,
        "minLength": 5,
        "pattern": "^[a-z][a-z0-9]*\\.[a-z][a-z0-9]*\\.[a-z][a-z0-9]*$",
        "title": "ServicePermission",
        "type": "string"
      },
      "ServiceResource": {
        "additionalProperties": false,
        "description": "Visão consolidada da ligação de um serviço exposta pela API (GET /v1/sum/services/{resourceId}), legível pelo dono da ligação e por operadores. Não expõe campos internos do SSOT (failureCount, requestedBy).",
        "properties": {
          "conditions": {
            "items": {
              "$ref": "#/components/schemas/Condition"
            },
            "maxItems": 32,
            "title": "Conditions",
            "type": "array"
          },
          "createdAt": {
            "format": "date-time",
            "title": "Createdat",
            "type": "string"
          },
          "desired": {
            "$ref": "#/components/schemas/ServiceDesiredData"
          },
          "desiredGeneration": {
            "maximum": 9007199254740991.0,
            "minimum": 1.0,
            "title": "Desiredgeneration",
            "type": "integer"
          },
          "observed": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ServiceObservedData"
              },
              {
                "type": "null"
              }
            ]
          },
          "observedGeneration": {
            "anyOf": [
              {
                "maximum": 9007199254740991.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Observedgeneration"
          },
          "phase": {
            "$ref": "#/components/schemas/Phase"
          },
          "resourceId": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-z0-9]([a-z0-9-]{0,126}[a-z0-9])?$",
            "title": "Resourceid",
            "type": "string"
          },
          "resourceVersion": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9-]+$",
            "title": "Resourceversion",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "title": "Updatedat",
            "type": "string"
          }
        },
        "required": [
          "resourceId",
          "resourceVersion",
          "desiredGeneration",
          "phase",
          "conditions",
          "desired",
          "createdAt",
          "updatedAt"
        ],
        "title": "ServiceResource",
        "type": "object"
      },
      "State": {
        "description": "Estado do serviço para o solicitante.",
        "enum": [
          "available",
          "enabled"
        ],
        "title": "State",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "smarkee sum service api",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "health_live_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Live Health Live Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health Live"
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "health_ready_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health Ready"
      }
    },
    "/health/startup": {
      "get": {
        "operationId": "health_startup_health_startup_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Startup Health Startup Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health Startup"
      }
    },
    "/v1/sum/services": {
      "get": {
        "description": "Ligações do solicitante cujo serviço ele pode ler (`sum.<serviço>.get`).",
        "operationId": "list_services_v1_sum_services_get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 200,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceListResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Services"
      },
      "post": {
        "operationId": "create_service_v1_sum_services_post",
        "parameters": [
          {
            "in": "header",
            "name": "idempotency-key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ServiceCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceResource"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Service"
      }
    },
    "/v1/sum/services/available": {
      "get": {
        "description": "Lista os serviços disponíveis no catálogo da plataforma para serem habilitados.",
        "operationId": "list_available_services_v1_sum_services_available_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AvailableServicesResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Available Services"
      }
    },
    "/v1/sum/services/{resource_id}": {
      "delete": {
        "operationId": "delete_service_v1_sum_services__resource_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "resource_id",
            "required": true,
            "schema": {
              "title": "Resource Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "resourceVersion",
            "required": true,
            "schema": {
              "pattern": "^[0-9]{1,18}$",
              "title": "Resourceversion",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "idempotency-key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Idempotency-Key"
            }
          }
        ],
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceResource"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Delete Service"
      },
      "get": {
        "operationId": "get_service_v1_sum_services__resource_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "resource_id",
            "required": true,
            "schema": {
              "title": "Resource Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceResource"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Service"
      }
    }
  }
}
