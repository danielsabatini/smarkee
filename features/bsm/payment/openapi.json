          "customerAccountId": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:@-]+$",
            "title": "Customeraccountid",
            "type": "string"
          },
          "displayName": {
            "maxLength": 120,
            "minLength": 1,
            "pattern": "^[^\\r\\n\\t]+$",
            "title": "Displayname",
            "type": "string"
          },
          "methodType": {
            "$ref": "#/components/schemas/PaymentMethodType"
          },
          "provider": {
            "$ref": "#/components/schemas/PaymentProvider"
          },
          "providerToken": {
            "maxLength": 256,
            "minLength": 4,
            "pattern": "^[A-Za-z0-9._-]+$",
            "title": "Providertoken",
            "type": "string"
          }
        },
        "required": [
          "customerAccountId",
          "displayName",
          "provider",
          "methodType",
          "providerToken"
        ],
        "title": "PaymentCreateRequest",
        "type": "object"
      },
      "PaymentDesiredView": {
        "additionalProperties": false,
        "properties": {
          "customerAccountId": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:@-]+$",
