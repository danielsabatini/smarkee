      "PaymentCreateRequest": {
        "additionalProperties": false,
        "description": "Corpo de POST /v1/bsm/payments. A API valida que customerAccountId pertence ao solicitante autenticado (salvo operador) e atribui resourceId, ownerAccountId = customerAccountId e deletionProtection = true.",
