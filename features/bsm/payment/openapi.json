            "title": "Deletionprotection"
          },
          "displayName": {
            "maxLength": 120,
            "minLength": 1,
            "pattern": "^[^\\r\\n\\t]+$",
            "title": "Displayname",
            "type": "string"
          },
          "lifecycle": {
