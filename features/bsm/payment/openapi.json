        "title": "Condition",
        "type": "object"
      },
      "ConditionStatus": {
        "enum": [
          "True",
          "False",
          "Unknown"
        ],
        "title": "ConditionStatus",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Lifecycle": {
        "description": "Intenção de existência, em desired.",
        "enum": [
          "present",
          "absent"
        ],
        "title": "Lifecycle",
        "type": "string"
      },
      "Payment": {
        "additionalProperties": false,
        "description": "Visão consolidada do método de pagamento (bsm.payment) exposta pela API (GET/POST/PATCH/DELETE). Não expõe o dono (ownerAccountId), o token bruto (providerToken) nem campos internos do SSOT (failureCount, requestedBy).",
