{
  "components": {
    "schemas": {
      "ApiAcceptedResponse": {
        "additionalProperties": false,
        "description": "Resposta das escritas assíncronas (POST, PATCH, DELETE): o pedido foi publicado, não aplicado (RESOURCE-CONTROL-LOOP.md, Interface HTTP).",
        "properties": {
          "operationId": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-z0-9]([a-z0-9-]{0,126}[a-z0-9])?$",
            "title": "Operationid",
            "type": "string"
          },
          "resourceId": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-z0-9]([a-z0-9-]{0,126}[a-z0-9])?$",
            "title": "Resourceid",
            "type": "string"
          }
        },
        "required": [
          "resourceId",
          "operationId"
        ],
        "title": "ApiAcceptedResponse",
        "type": "object"
      },
      "BillingAccount": {
        "additionalProperties": false,
        "description": "Visão consolidada da Billing Account (bsm.account) exposta pelo Receiver (GET). Não expõe o dono (ownerAccountId) nem campos internos do SSOT (failureCount, requestedBy).",
        "properties": {
          "conditions": {
            "items": {
              "$ref": "#/components/schemas/Condition"
            },
            "maxItems": 32,
            "title": "Conditions",
            "type": "array"
          },
          "createdAt": {
            "format": "date-time",
            "title": "Createdat",
            "type": "string"
          },
          "desired": {
            "$ref": "#/components/schemas/BillingAccountDesiredView"
          },
          "desiredGeneration": {
            "maximum": 9007199254740991.0,
            "minimum": 1.0,
            "title": "Desiredgeneration",
            "type": "integer"
          },
          "observed": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BillingAccountObservedView"
              },
              {
                "type": "null"
              }
            ],
            "title": "BillingAccountObservedView"
          },
          "phase": {
            "$ref": "#/components/schemas/Phase"
          },
          "resourceId": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-z0-9]([a-z0-9-]{0,126}[a-z0-9])?$",
            "title": "Resourceid",
            "type": "string"
          },
          "resourceVersion": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9-]+$",
            "title": "Resourceversion",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "title": "Updatedat",
            "type": "string"
          }
        },
        "required": [
          "resourceId",
          "resourceVersion",
          "desiredGeneration",
          "phase",
          "conditions",
          "desired",
          "createdAt",
          "updatedAt"
        ],
        "title": "BillingAccount",
        "type": "object"
      },
      "BillingAccountCreateRequest": {
        "additionalProperties": false,
        "description": "Corpo de POST /v1/bsm/accounts. O Receiver atribui resourceId, operationId, requestDigest e requestedBy, e o Manager atribui ownerAccountId = solicitante autenticado e deletionProtection = true.",
        "properties": {
          "billingContacts": {
            "items": {
              "$ref": "#/components/schemas/BillingContact"
            },
            "maxItems": 10,
            "minItems": 1,
            "title": "Billingcontacts",
            "type": "array"
          },
          "billingCurrency": {
            "$ref": "#/components/schemas/BillingCurrency"
          },
          "displayName": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
            "title": "Displayname",
            "type": "string"
          }
        },
        "required": [
          "displayName",
          "billingCurrency",
          "billingContacts"
        ],
        "title": "BillingAccountCreateRequest",
        "type": "object"
      },
      "BillingAccountDesiredView": {
        "additionalProperties": false,
        "properties": {
          "billingContacts": {
            "items": {
              "$ref": "#/components/schemas/BillingContact"
            },
            "maxItems": 10,
            "minItems": 1,
            "title": "Billingcontacts",
            "type": "array"
          },
          "billingCurrency": {
            "$ref": "#/components/schemas/BillingCurrency"
          },
          "deletionProtection": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Deletionprotection"
          },
          "displayName": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
            "title": "Displayname",
            "type": "string"
          },
          "lifecycle": {
            "$ref": "#/components/schemas/Lifecycle"
          },
          "reconciliation": {
            "$ref": "#/components/schemas/Reconciliation"
          }
        },
        "required": [
          "lifecycle",
          "reconciliation",
          "displayName",
          "billingCurrency",
          "billingContacts"
        ],
        "title": "BillingAccountDesiredView",
        "type": "object"
      },
      "BillingAccountList": {
        "additionalProperties": false,
        "description": "Resposta de GET /v1/bsm/accounts: página ordenada por resourceId, somente das Billing Accounts autorizadas. nextCursor ausente indica a última página.",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/BillingAccount"
            },
            "maxItems": 200,
            "title": "Items",
            "type": "array"
          },
          "nextCursor": {
            "anyOf": [
              {
                "maxLength": 512,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9_-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Nextcursor"
          }
        },
        "required": [
          "items"
        ],
        "title": "BillingAccountList",
        "type": "object"
      },
      "BillingAccountObservedView": {
        "additionalProperties": false,
        "description": "Última observação; ausente antes da primeira.",
        "properties": {
          "billingContacts": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/BillingContact"
                },
                "maxItems": 10,
                "minItems": 1,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Billingcontacts"
          },
          "billingCurrency": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BillingCurrency"
              },
              {
                "type": "null"
              }
            ]
          },
          "deletionProtection": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Deletionprotection"
          },
          "displayName": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Displayname"
          },
          "observedAt": {
            "format": "date-time",
            "title": "Observedat",
            "type": "string"
          },
          "presence": {
            "$ref": "#/components/schemas/Presence"
          }
        },
        "required": [
          "presence",
          "observedAt"
        ],
        "title": "BillingAccountObservedView",
        "type": "object"
      },
      "BillingAccountUpdateRequest": {
        "additionalProperties": false,
        "description": "Corpo de PATCH /v1/bsm/accounts/{resourceId}. resourceVersion é a versão lida; pelo menos um campo deve ser alterado. billingCurrency não é aceito porque é imutável.",
        "properties": {
          "billingContacts": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/BillingContact"
                },
                "maxItems": 10,
                "minItems": 1,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Billingcontacts"
          },
          "deletionProtection": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Deletionprotection"
          },
          "displayName": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Displayname"
          },
          "reconciliation": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Reconciliation"
              },
              {
                "type": "null"
              }
            ]
          },
          "resourceVersion": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9-]+$",
            "title": "Resourceversion",
            "type": "string"
          }
        },
        "required": [
          "resourceVersion"
        ],
        "title": "BillingAccountUpdateRequest",
        "type": "object"
      },
      "BillingContact": {
        "format": "email",
        "maxLength": 254,
        "minLength": 3,
        "title": "BillingContact",
        "type": "string"
      },
      "BillingCurrency": {
        "description": "Moeda ISO 4217 na qual a conta é faturada (BillingCurrency no FOCUS 1.4). Imutável após a criação.",
        "enum": [
          "BRL",
          "USD",
          "EUR"
        ],
        "title": "BillingCurrency",
        "type": "string"
      },
      "Condition": {
        "additionalProperties": false,
        "description": "Fato consolidado do recurso (RESOURCE-CONTROL-LOOP.md, Conditions). Mantida pelo Manager.",
        "properties": {
          "lastTransitionAt": {
            "format": "date-time",
            "title": "Lasttransitionat",
            "type": "string"
          },
          "message": {
            "anyOf": [
              {
                "maxLength": 4096,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          },
          "observedGeneration": {
            "anyOf": [
              {
                "maximum": 9007199254740991.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Observedgeneration"
          },
          "reason": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Z][A-Za-z0-9]*$",
            "title": "Reason",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/ConditionStatus"
          },
          "type": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Z][A-Za-z0-9]*$",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "status",
          "reason",
          "lastTransitionAt"
        ],
        "title": "Condition",
        "type": "object"
      },
      "ConditionStatus": {
        "enum": [
          "True",
          "False",
          "Unknown"
        ],
        "title": "ConditionStatus",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Lifecycle": {
        "description": "Intenção de existência, em desired.",
        "enum": [
          "present",
          "absent"
        ],
        "title": "Lifecycle",
        "type": "string"
      },
      "Operation": {
        "additionalProperties": false,
        "description": "Acompanhamento de uma solicitação assíncrona, exposto por GET /v1/operations/{operationId} (SSOT.md, Operation).",
        "properties": {
          "completedAt": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completedat"
          },
          "createdAt": {
            "format": "date-time",
            "title": "Createdat",
            "type": "string"
          },
          "desiredGeneration": {
            "anyOf": [
              {
                "maximum": 9007199254740991.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Desiredgeneration"
          },
          "module": {
            "maxLength": 63,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9-]*$",
            "title": "Module",
            "type": "string"
          },
          "operationId": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-z0-9]([a-z0-9-]{0,126}[a-z0-9])?$",
            "title": "Operationid",
            "type": "string"
          },
          "operationStatus": {
            "$ref": "#/components/schemas/OperationStatus"
          },
          "operationStatusReason": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/OperationStatusReason"
              },
              {
                "type": "null"
              }
            ],
            "title": "OperationStatusReason"
          },
          "operationType": {
            "$ref": "#/components/schemas/OperationType"
          },
          "resourceId": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-z0-9]([a-z0-9-]{0,126}[a-z0-9])?$",
            "title": "Resourceid",
            "type": "string"
          },
          "resourceType": {
            "maxLength": 63,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9-]*$",
            "title": "Resourcetype",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "title": "Updatedat",
            "type": "string"
          }
        },
        "required": [
          "operationId",
          "operationType",
          "module",
          "resourceType",
          "resourceId",
          "operationStatus",
          "createdAt",
          "updatedAt"
        ],
        "title": "Operation",
        "type": "object"
      },
      "OperationStatus": {
        "enum": [
          "accepted",
          "in_progress",
          "completed",
          "failed",
          "rejected"
        ],
        "title": "OperationStatus",
        "type": "string"
      },
      "OperationStatusReason": {
        "description": "Motivo da rejeição; presente somente quando operationStatus é rejected. protected: o recurso tem a proteção contra exclusão ligada (decisão 0043).",
        "enum": [
          "conflict",
          "validation",
          "not_found",
          "protected"
        ],
        "title": "OperationStatusReason",
        "type": "string"
      },
      "OperationType": {
        "enum": [
          "create",
          "update",
          "delete"
        ],
        "title": "OperationType",
        "type": "string"
      },
      "Phase": {
        "description": "Fase consolidada do recurso (RESOURCE-CONTROL-LOOP.md, Lifecycle).",
        "enum": [
          "Pending",
          "Reconciling",
          "Ready",
          "Failed",
          "Deleting"
        ],
        "title": "Phase",
        "type": "string"
      },
      "Presence": {
        "description": "Resultado da observação, no envelope de observed. unknown nunca é tratado como absent.",
        "enum": [
          "present",
          "absent",
          "unknown"
        ],
        "title": "Presence",
        "type": "string"
      },
      "Reconciliation": {
        "description": "Controle da reconciliação, em desired. Quando suspended, o Reconciler não decide.",
        "enum": [
          "active",
          "suspended"
        ],
        "title": "Reconciliation",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
