# Componentes core-user (receiver, manager, publisher, reconciler, observer e executor). Copie para .env (fora do git) e preencha o
# que está vazio.

# Senhas dos papéis de login do SSOT. Em dev são triviais e iguais ao nome do papel
# (infrastructure/dev/database/bootstrap/core.sql). Em stg e prd, vêm da gestão de segredos.
CORE_USER_RECEIVER_DATABASE_PASSWORD=core_user_receiver_login
CORE_USER_MANAGER_DATABASE_PASSWORD=core_user_manager_login
CORE_USER_PUBLISHER_DATABASE_PASSWORD=core_user_publisher_login

# Obrigatório. A mesma NATS_PASSWORD de broker/.env (em dev, um único usuário no NATS).
CORE_USER_RECEIVER_NATS_PASSWORD=
CORE_USER_MANAGER_NATS_PASSWORD=
CORE_USER_PUBLISHER_NATS_PASSWORD=
CORE_USER_RECONCILER_NATS_PASSWORD=

# Obrigatório. ID do projeto `roles` (organização `core` do Zitadel): é a audience dos tokens.
CORE_USER_RECEIVER_AUTH_AUDIENCE=

# Observer e Executor: senha do NATS (a mesma NATS_PASSWORD de broker/.env).
CORE_USER_OBSERVER_NATS_PASSWORD=
CORE_USER_EXECUTOR_NATS_PASSWORD=

# Obrigatórios. IDs no Zitadel: organização `register` (usuários cadastrados) e projeto `roles` (da
# organização `core`). O Project Grant do projeto para a `register` limita as roles, sem ID aqui.
CORE_ZITADEL_REGISTER_ORGANIZATION_ID=
CORE_ZITADEL_PROJECT_ID=

# Opcionais (têm default no compose.yaml): tags das imagens construídas localmente e das imagens de apoio.
# CORE_USER_RECEIVER_IMAGE, CORE_USER_MANAGER_IMAGE, CORE_USER_PUBLISHER_IMAGE,
# CORE_USER_RECONCILER_IMAGE, CORE_USER_OBSERVER_IMAGE, CORE_USER_EXECUTOR_IMAGE,
# POSTGRES_CLIENT_IMAGE, NATS_CLIENT_IMAGE (imagens de `infrastructure/tools`), NATS_USER
