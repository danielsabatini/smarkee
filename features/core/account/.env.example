# Componentes core-account (receiver, manager, publisher, reconciler, observer e executor). Copie para .env (fora do git) e preencha o
# que está vazio.

# Senhas dos papéis de login do SSOT. Em dev são triviais e iguais ao nome do papel
# (infrastructure/dev/database/bootstrap/core.sql). Em stg e prd, vêm da gestão de segredos.
CORE_ACCOUNT_RECEIVER_DATABASE_PASSWORD=core_account_receiver_login
CORE_ACCOUNT_MANAGER_DATABASE_PASSWORD=core_account_manager_login
CORE_ACCOUNT_PUBLISHER_DATABASE_PASSWORD=core_account_publisher_login

# Obrigatório. A mesma SMARKEE_MESSAGING_PASSWORD de messaging/.env (em dev, um único usuário no NATS).
CORE_ACCOUNT_RECEIVER_MESSAGING_PASSWORD=
CORE_ACCOUNT_MANAGER_MESSAGING_PASSWORD=
CORE_ACCOUNT_PUBLISHER_MESSAGING_PASSWORD=
CORE_ACCOUNT_RECONCILER_MESSAGING_PASSWORD=

# Obrigatório. ID do projeto `roles-core` (organização `core` do Zitadel): é a audience dos tokens.
CORE_ACCOUNT_RECEIVER_AUTH_AUDIENCE=

# Observer e Executor: senha do NATS (a mesma SMARKEE_MESSAGING_PASSWORD de messaging/.env).
CORE_ACCOUNT_OBSERVER_MESSAGING_PASSWORD=
CORE_ACCOUNT_EXECUTOR_MESSAGING_PASSWORD=

# Obrigatórios. IDs no Zitadel: organização `register` (usuários cadastrados) e, por módulo, o projeto
# de roles que o Executor concede (JSON; só os módulos em que ele é `PROJECT_GRANT_OWNER`, decisões 0032 e 0082):
# CORE_ACCOUNT_IDENTITY_PROJECT_IDS={"bsm":"<ID de roles-bsm>","core":"<ID de roles-core>","sum":"<ID de roles-sum>"}
CORE_ACCOUNT_IDENTITY_REGISTER_ORGANIZATION_ID=
CORE_ACCOUNT_IDENTITY_PROJECT_IDS=

# Opcionais (têm default no compose.yaml; descomente só para mudar).
# Imagem única da feature, construída localmente (decisão 0063).
# CORE_ACCOUNT_IMAGE=smarkee-core-account:dev
# Limite de CPU de cada um dos 6 papéis.
# CORE_ACCOUNT_COMPONENT_CPUS=0.5
# Limite de memória de cada um dos 6 papéis.
# CORE_ACCOUNT_COMPONENT_MEMORY=256M
# Limite de CPU do telemeter da feature.
# CORE_ACCOUNT_TELEMETER_CPUS=0.25
# Limite de memória do telemeter da feature.
# CORE_ACCOUNT_TELEMETER_MEMORY=192M
# Ambiente informado à telemetria (dev, stg, prd).
# SMARKEE_ENVIRONMENT=dev
# Imagem do coletor, a mesma da infraestrutura.
# SMARKEE_TELEMETRY_IMAGE_VERSION=otel/opentelemetry-collector-contrib:0.163.1
# Imagem do cliente psql (infrastructure/tools).
# SMARKEE_DATABASE_CLIENT_IMAGE=smarkee-psql-client:dev
# Imagem da CLI nats (infrastructure/tools).
# SMARKEE_MESSAGING_CLIENT_IMAGE=smarkee-nats-client:dev
# Usuário do NATS (o mesmo de messaging/.env).
# SMARKEE_MESSAGING_USER=smarkee

# Execução local (fora do Docker): `uv run --env-file .env <comando>` contra as portas publicadas pela
# infraestrutura. O ambiente vence o config.toml, e o compose só repassa as variáveis que lista, então
# estas linhas não afetam os contêineres. Descomente e ajuste por papel (exemplo: receiver).
# CORE_ACCOUNT_RECEIVER_DATABASE_HOST=localhost
# CORE_ACCOUNT_RECEIVER_DATABASE_PORT=5432
# CORE_ACCOUNT_RECEIVER_DATABASE_NAME=smarkee
# CORE_ACCOUNT_RECEIVER_DATABASE_USER=core_account_receiver_login
# CORE_ACCOUNT_RECEIVER_MESSAGING_URL=nats://localhost:4222
# CORE_ACCOUNT_RECEIVER_MESSAGING_USER=smarkee
