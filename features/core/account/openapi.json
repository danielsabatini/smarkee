{
  "components": {
    "schemas": {
      "Account": {
        "additionalProperties": false,
        "description": "Visão consolidada da Account exposta pela API (GET /v1/core/accounts/{resourceId}), legível pelo próprio usuário e por operadores. Não expõe campos internos do SSOT (failureCount, requestedBy).",
        "properties": {
          "conditions": {
            "items": {
              "$ref": "#/components/schemas/Condition"
            },
            "maxItems": 32,
            "title": "Conditions",
            "type": "array"
          },
          "createdAt": {
            "format": "date-time",
            "title": "Createdat",
            "type": "string"
          },
          "desired": {
            "$ref": "#/components/schemas/AccountDesiredView"
          },
          "desiredGeneration": {
            "maximum": 9007199254740991.0,
            "minimum": 1.0,
            "title": "Desiredgeneration",
            "type": "integer"
          },
          "observed": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AccountObservedView"
              },
              {
                "type": "null"
              }
            ],
            "title": "AccountObservedView"
          },
          "observedGeneration": {
            "anyOf": [
              {
                "maximum": 9007199254740991.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Observedgeneration"
          },
          "phase": {
            "$ref": "#/components/schemas/Phase"
          },
          "resourceId": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-z0-9]([a-z0-9-]{0,126}[a-z0-9])?$",
            "title": "Resourceid",
            "type": "string"
          },
          "resourceVersion": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9-]+$",
            "title": "Resourceversion",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "title": "Updatedat",
            "type": "string"
          }
        },
        "required": [
          "resourceId",
          "resourceVersion",
          "desiredGeneration",
          "phase",
          "conditions",
          "desired",
          "createdAt",
          "updatedAt"
        ],
        "title": "Account",
        "type": "object"
      },
      "AccountCreateRequest": {
        "additionalProperties": false,
        "description": "Corpo de POST /v1/core/accounts (auto-cadastro, escrita anônima). A API atribui o resourceId e requestedBy = anonymous. Não há senha: a pessoa a define na página do provedor de identidade, pelo e-mail de ativação.",
        "properties": {
          "email": {
            "format": "email",
            "maxLength": 254,
            "minLength": 3,
            "title": "Email",
            "type": "string"
          },
          "familyName": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Familyname",
            "type": "string"
          },
          "givenName": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Givenname",
            "type": "string"
          }
        },
        "required": [
          "givenName",
          "familyName",
          "email"
        ],
        "title": "AccountCreateRequest",
        "type": "object"
      },
      "AccountDesiredView": {
        "additionalProperties": false,
        "properties": {
          "deletionProtection": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Deletionprotection"
          },
          "email": {
            "anyOf": [
              {
                "format": "email",
                "maxLength": 254,
                "minLength": 3,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "familyName": {
            "anyOf": [
              {
                "maxLength": 256,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Familyname"
          },
          "givenName": {
            "anyOf": [
              {
                "maxLength": 256,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Givenname"
          },
          "lifecycle": {
            "$ref": "#/components/schemas/Lifecycle"
          },
          "platformAccess": {
            "$ref": "#/components/schemas/PlatformAccess"
          },
          "platformPermissions": {
            "items": {
              "$ref": "#/components/schemas/PlatformPermission"
            },
            "maxItems": 64,
            "title": "Platformpermissions",
            "type": "array"
          },
          "reconciliation": {
            "$ref": "#/components/schemas/Reconciliation"
          }
        },
        "required": [
          "lifecycle",
          "reconciliation",
          "platformAccess",
          "platformPermissions"
        ],
        "title": "AccountDesiredView",
        "type": "object"
      },
      "AccountObservedView": {
        "additionalProperties": false,
        "description": "Última observação; ausente antes da primeira.",
        "properties": {
          "accountState": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AccountState"
              },
              {
                "type": "null"
              }
            ]
          },
          "deletionProtection": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Deletionprotection"
          },
          "emailVerified": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Emailverified"
          },
          "observedAt": {
            "format": "date-time",
            "title": "Observedat",
            "type": "string"
          },
          "platformAccess": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PlatformAccess"
              },
              {
                "type": "null"
              }
            ]
          },
          "platformPermissions": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/PlatformPermission"
                },
                "maxItems": 64,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Platformpermissions"
          },
          "presence": {
            "$ref": "#/components/schemas/Presence"
          }
        },
        "required": [
          "presence",
          "observedAt"
        ],
        "title": "AccountObservedView",
        "type": "object"
      },
      "AccountRegistrationResponse": {
        "additionalProperties": false,
        "description": "Resposta de POST /v1/core/accounts (auto-cadastro, escrita anônima): o pedido foi aceito, não aplicado. Uniforme: é a mesma exista ou não o e-mail, e por isso não traz o recurso nem o estado (RESOURCE-CONTROL-LOOP.md §6.1.2). O resourceId só identifica o cadastro para quem o fez; o e-mail de ativação é o canal de confirmação.",
        "properties": {
          "registrationTicket": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[a-z0-9]([a-z0-9-]{0,126}[a-z0-9])?$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Registrationticket"
          },
          "resourceId": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-z0-9]([a-z0-9-]{0,126}[a-z0-9])?$",
            "title": "Resourceid",
            "type": "string"
          },
          "ticketExpiresAt": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ticketexpiresat"
          }
        },
        "required": [
          "resourceId"
        ],
        "title": "AccountRegistrationResponse",
        "type": "object"
      },
      "AccountRegistrationStatus": {
        "additionalProperties": false,
        "description": "Status do processo de ativação da conta obtido através de um ticket temporário de rastreamento (UUIDv7). Seguro contra enumeração de e-mails e vazamento de dados pessoais.",
        "properties": {
          "activated": {
            "title": "Activated",
            "type": "boolean"
          },
          "emailDispatched": {
            "title": "Emaildispatched",
            "type": "boolean"
          },
          "emailMasked": {
            "maxLength": 320,
            "minLength": 3,
            "title": "Emailmasked",
            "type": "string"
          },
          "phase": {
            "$ref": "#/components/schemas/Phase"
          },
          "ticketExpiresAt": {
            "format": "date-time",
            "title": "Ticketexpiresat",
            "type": "string"
          }
        },
        "required": [
          "phase",
          "emailMasked",
          "emailDispatched",
          "activated",
          "ticketExpiresAt"
        ],
        "title": "AccountRegistrationStatus",
        "type": "object"
      },
      "AccountState": {
        "description": "Estado do usuário no provedor de identidade. initial: aguardando a ativação (definição da senha).",
        "enum": [
          "initial",
          "active",
          "inactive",
          "locked"
        ],
        "title": "AccountState",
        "type": "string"
      },
      "AccountUpdateRequest": {
        "additionalProperties": false,
        "description": "Corpo de PATCH /v1/core/accounts/{resourceId}. resourceVersion é a versão lida; a única alteração possível é a proteção contra exclusão.",
        "properties": {
          "deletionProtection": {
            "title": "Deletionprotection",
            "type": "boolean"
          },
          "resourceVersion": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9-]+$",
            "title": "Resourceversion",
            "type": "string"
          }
        },
        "required": [
          "resourceVersion",
          "deletionProtection"
        ],
        "title": "AccountUpdateRequest",
        "type": "object"
      },
      "Condition": {
        "additionalProperties": false,
        "description": "Fato consolidado do recurso (RESOURCE-CONTROL-LOOP.md, Conditions). Mantida pelo Manager.",
        "properties": {
          "lastTransitionAt": {
            "format": "date-time",
            "title": "Lasttransitionat",
            "type": "string"
          },
          "message": {
            "anyOf": [
              {
                "maxLength": 4096,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          },
          "observedGeneration": {
            "anyOf": [
              {
                "maximum": 9007199254740991.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Observedgeneration"
          },
          "reason": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Z][A-Za-z0-9]*$",
            "title": "Reason",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/ConditionStatus"
          },
          "type": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Z][A-Za-z0-9]*$",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "status",
          "reason",
          "lastTransitionAt"
        ],
        "title": "Condition",
        "type": "object"
      },
      "ConditionStatus": {
        "enum": [
          "True",
          "False",
          "Unknown"
        ],
        "title": "ConditionStatus",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Lifecycle": {
        "description": "Intenção de existência, em desired.",
        "enum": [
          "present",
          "absent"
        ],
        "title": "Lifecycle",
        "type": "string"
      },
      "Phase": {
        "description": "Fase consolidada do recurso (RESOURCE-CONTROL-LOOP.md, Lifecycle).",
        "enum": [
          "Pending",
          "Reconciling",
          "Ready",
          "Failed",
          "Deleting"
        ],
        "title": "Phase",
        "type": "string"
      },
      "PlatformAccess": {
        "description": "Intenção de acesso à plataforma: granted mantém a autorização no projeto da plataforma (Project Grant da Organization; conjunto de permissões de ação do usuário cadastrado, na Account); revoked a remove.",
        "enum": [
          "granted",
          "revoked"
        ],
        "title": "PlatformAccess",
        "type": "string"
      },
      "PlatformPermission": {
        "maxLength": 128,
        "minLength": 5,
        "pattern": "^[a-z][a-z0-9]*\\.[a-z][a-z0-9]*\\.[a-z][a-z0-9]*$",
        "title": "PlatformPermission",
        "type": "string"
      },
      "Presence": {
        "description": "Resultado da observação, no envelope de observed. unknown nunca é tratado como absent.",
        "enum": [
          "present",
          "absent",
          "unknown"
        ],
        "title": "Presence",
        "type": "string"
      },
      "Reconciliation": {
        "description": "Controle da reconciliação, em desired. Quando suspended, o Reconciler não decide.",
        "enum": [
          "active",
          "suspended"
        ],
        "title": "Reconciliation",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "smarkee core account api",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "health_live_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Live Health Live Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health Live"
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "health_ready_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health Ready"
      }
    },
    "/health/startup": {
      "get": {
        "operationId": "health_startup_health_startup_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Startup Health Startup Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health Startup"
      }
    },
    "/v1/core/accounts": {
      "post": {
        "description": "Auto-cadastro: escrita anônima (`RESOURCE-CONTROL-LOOP.md` §6.1.2).\n\nResposta uniforme: o mesmo `202` com um `resourceId` novo exista ou não o e-mail. Se ele já\nestá em uso, nada é gravado.",
        "operationId": "register_account_v1_core_accounts_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccountCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountRegistrationResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Register Account"
      }
    },
    "/v1/core/accounts/registration-status/{ticket}": {
      "get": {
        "description": "Consulta anônima do status de ativação através do ticket temporário.",
        "operationId": "registration_status_v1_core_accounts_registration_status__ticket__get",
        "parameters": [
          {
            "in": "path",
            "name": "ticket",
            "required": true,
            "schema": {
              "title": "Ticket",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountRegistrationStatus"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Registration Status"
      }
    },
    "/v1/core/accounts/registration-status/{ticket}/resend": {
      "post": {
        "description": "Solicita reenvio do e-mail de ativação via ticket temporário.",
        "operationId": "resend_registration_v1_core_accounts_registration_status__ticket__resend_post",
        "parameters": [
          {
            "in": "path",
            "name": "ticket",
            "required": true,
            "schema": {
              "title": "Ticket",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Resend Registration"
      }
    },
    "/v1/core/accounts/{account_id}": {
      "delete": {
        "operationId": "delete_account_v1_core_accounts__account_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "account_id",
            "required": true,
            "schema": {
              "title": "Account Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "resourceVersion",
            "required": true,
            "schema": {
              "pattern": "^[0-9]{1,18}$",
              "title": "Resourceversion",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "idempotency-key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Idempotency-Key"
            }
          }
        ],
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Account"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Delete Account"
      },
      "get": {
        "operationId": "get_account_v1_core_accounts__account_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "account_id",
            "required": true,
            "schema": {
              "title": "Account Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Account"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Account"
      },
      "patch": {
        "description": "Única alteração possível: a proteção contra exclusão (decisão 0043).\n\nUsa a mesma permissão do `delete`: quem pode apagar a conta pode (des)proteger.",
        "operationId": "update_account_v1_core_accounts__account_id__patch",
        "parameters": [
          {
            "in": "path",
            "name": "account_id",
            "required": true,
            "schema": {
              "title": "Account Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "idempotency-key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccountUpdateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Account"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Update Account"
      }
    }
  }
}
