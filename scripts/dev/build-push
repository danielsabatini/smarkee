#!/usr/bin/env bash
# Constrói as imagens das features da Smarkee (e do psql-client) e publica no registry local
# (`localhost:5001`, CNCF Distribution v3, decisão 0102).
#
# Uso:
#   ./scripts/dev/build-push                 # constrói e publica todas as 9 features + psql-client
#   ./scripts/dev/build-push core/account    # constrói e publica apenas a feature informada
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"
REGISTRY="${SMARKEE_REGISTRY:-localhost:5001}"
TAG="${SMARKEE_IMAGE_TAG:-dev}"

log() {
  printf "\033[1;34m[build-push]\033[0m %s\n" "$*"
}

build_and_push_feature() {
  local feat="$1"
  local mod="${feat%/*}"
  local typ="${feat#*/}"
  local img_name="smarkee-${mod}-${typ}"
  local feat_dir="${REPO_ROOT}/features/${mod}/${typ}"

  log "Building ${img_name}:${TAG} from features/${feat}..."
  docker build -q -t "${img_name}:${TAG}" -t "${REGISTRY}/${img_name}:${TAG}" "${feat_dir}" >/dev/null
  log "Pushing ${REGISTRY}/${img_name}:${TAG}..."
  docker push -q "${REGISTRY}/${img_name}:${TAG}" >/dev/null
  if docker inspect smarkee-control-plane >/dev/null 2>&1; then
    docker exec smarkee-control-plane crictl pull "${REGISTRY}/${img_name}:${TAG}" >/dev/null
  fi
}

if [[ $# -gt 0 ]]; then
  for arg in "$@"; do
    build_and_push_feature "${arg}"
  done
  exit 0
fi

# Para o psql-client, usa a imagem local existente ou constrói se não existir
if ! docker image inspect "smarkee-psql-client:${TAG}" >/dev/null 2>&1; then
  log "Building smarkee-psql-client:${TAG}..."
  docker build -q -t "smarkee-psql-client:${TAG}" "${REPO_ROOT}/infrastructure/tools/psql-client" >/dev/null
fi
docker tag "smarkee-psql-client:${TAG}" "${REGISTRY}/smarkee-psql-client:${TAG}"
log "Pushing ${REGISTRY}/smarkee-psql-client:${TAG}..."
docker push -q "${REGISTRY}/smarkee-psql-client:${TAG}" >/dev/null

FEATURES=(
  "core/account"
  "bsm/account"
  "sum/service"
  "ipm/organization"
  "ipm/user"
  "ipm/serviceaccount"
  "ipm/permission"
  "ipm/role"
  "ipm/group"
)

for feat in "${FEATURES[@]}"; do
  build_and_push_feature "${feat}"
done

log "All images built and pushed to ${REGISTRY}!"
