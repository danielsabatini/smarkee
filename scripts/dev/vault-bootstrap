# 8.2 Garantir 24 External Identity Groups e Group Aliases dinâmicos vinculados a `groups_claim="roles"`
ensure_vault_identity_groups() {
  local ns="$1"
  local desc="root"
  if [[ -n "${ns}" ]]; then
    desc="${ns}/"
  fi

  bao_ns() {
    if [[ -n "${ns}" ]]; then
      bao_exec BAO_ADDR=http://127.0.0.1:8200 BAO_TOKEN="${ROOT_TOKEN}" BAO_NAMESPACE="${ns}" "$@"
    else
      bao_exec BAO_ADDR=http://127.0.0.1:8200 BAO_TOKEN="${ROOT_TOKEN}" "$@"
    fi
  }

  local auth_json
  auth_json="$(bao_ns bao auth list -format=json 2>/dev/null || true)"
  local oidc_accessor
  oidc_accessor="$(printf "%s" "${auth_json}" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("oidc/", {}).get("accessor", ""))' 2>/dev/null || true)"

  if [[ -z "${oidc_accessor}" ]]; then
    log "OIDC auth not enabled in '${desc}'; skipping external identity groups."
    return 0
  fi

  log "Ensuring 24 External Identity Groups and Group Aliases in '${desc}' (accessor: ${oidc_accessor})..."

  local permissions=(
    "vault.platform.create" "vault.platform.delete" "vault.platform.get" "vault.platform.list" "vault.platform.update" "vault.platform.operate"
    "svm.secret.create" "svm.secret.delete" "svm.secret.get" "svm.secret.list" "svm.secret.update" "svm.secret.operate"
    "ekm.key.create" "ekm.key.delete" "ekm.key.get" "ekm.key.list" "ekm.key.update" "ekm.key.operate"
    "clm.certificate.create" "clm.certificate.delete" "clm.certificate.get" "clm.certificate.list" "clm.certificate.update" "clm.certificate.operate"
  )

  for perm in "${permissions[@]}"; do
    local group_json
    group_json="$(bao_ns bao read -format=json "identity/group/name/${perm}" 2>/dev/null || true)"
    local gid=""
    local has_alias="false"

    if [[ -n "${group_json}" ]]; then
      gid="$(printf "%s" "${group_json}" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("data", {}).get("id", ""))' 2>/dev/null || true)"
      has_alias="$(printf "%s" "${group_json}" | python3 -c 'import json,sys; d=json.load(sys.stdin).get("data", {}).get("alias", {}); print("true" if d.get("mount_accessor") == sys.argv[1] else "false")' "${oidc_accessor}" 2>/dev/null || true)"
      bao_ns bao write "identity/group/name/${perm}" policies="${perm}" type="external" >/dev/null
    fi

    if [[ -z "${gid}" ]]; then
      local created_json
      created_json="$(bao_ns bao write -format=json identity/group name="${perm}" type="external" policies="${perm}")"
      gid="$(printf "%s" "${created_json}" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("data", {}).get("id", ""))')"
    fi

    if [[ "${has_alias}" != "true" && -n "${gid}" ]]; then
      bao_ns bao write identity/group-alias name="${perm}" canonical_id="${gid}" mount_accessor="${oidc_accessor}" >/dev/null
    fi
  done
}

