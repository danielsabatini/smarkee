# 8.3 Garantir Action `flatRoles` e triggers (4 e 5 no flow 2) no Zitadel para emissão de `roles: [...]`
ensure_zitadel_flat_roles_action() {
  local org_id="$1"
  if [[ -z "${org_id}" || "${org_id}" == "pending" ]]; then
    return 0
  fi

  local sa_file="${REPO_ROOT}/.workspace/service-account-platform-bootstrap.json"
  if [[ ! -f "${sa_file}" ]]; then
    sa_file="${REPO_ROOT}/.workspace/conformance-key.json"
  fi
  if [[ ! -f "${sa_file}" ]] && docker volume inspect identity-bootstrap >/dev/null 2>&1; then
    docker run --rm -v identity-bootstrap:/keys:ro alpine sh -c "cat /keys/service-account-platform-bootstrap.json 2>/dev/null || true" > "${REPO_ROOT}/.workspace/service-account-platform-bootstrap.json"
    sa_file="${REPO_ROOT}/.workspace/service-account-platform-bootstrap.json"
  fi

  if [[ ! -f "${sa_file}" ]]; then
    log "service-account-platform-bootstrap.json not found; skipping Zitadel flatRoles action configuration."
    return 0
  fi

  log "Ensuring Zitadel 'flatRoles' action and triggers (Complement Token flow=2, triggers=4,5) in org '${org_id}'..."

  SA_KEY_FILE="${sa_file}" IDENTITY_ISSUER="${IDENTITY_ISSUER}" ACTION_ORG_ID="${org_id}" uv run --project "${REPO_ROOT}/infrastructure/dev/identity/conformance" python - <<'EOF'
import json, time, sys, os, urllib.request, urllib.error, jwt

with open(os.environ["SA_KEY_FILE"], "r", encoding="utf-8") as f:
    key_data = json.load(f)
issuer = os.environ.get("IDENTITY_ISSUER", "http://ipm-dev.smarkee.com.br:8080")
org_id = os.environ.get("ACTION_ORG_ID", "")

now = int(time.time())
assertion = jwt.encode(
    {
        "iss": key_data["userId"],
        "sub": key_data["userId"],
        "aud": issuer,
        "iat": now,
        "exp": now + 300,
    },
    key_data["key"],
    algorithm="RS256",
    headers={"kid": key_data["keyId"]},
)

token_req = urllib.request.Request(
    f"{issuer}/oauth/v2/token",
    data=f"grant_type=urn%3Aietf%3Aparams%3Aoauth%3Agrant-type%3Ajwt-bearer&scope=openid+urn%3Azitadel%3Aiam%3Aorg%3Aproject%3Aid%3Azitadel%3Aaud&assertion={assertion}".encode("utf-8"),
    headers={"Host": "ipm-dev.smarkee.com.br:8080", "Content-Type": "application/x-www-form-urlencoded"}
)

try:
    with urllib.request.urlopen(token_req) as resp:
        token = json.loads(resp.read().decode("utf-8"))["access_token"]
except Exception as e:
    print(f"Failed to acquire Zitadel token for action setup: {e}", file=sys.stderr)
    sys.exit(0)

headers = {
    "Host": "ipm-dev.smarkee.com.br:8080",
    "Authorization": f"Bearer {token}",
    "x-zitadel-orgid": org_id,
    "Content-Type": "application/json"
}

script = """let logger = require("zitadel/log");

function flatRoles(ctx, api) {
  try {
    var rolesList = [];
    if (ctx && ctx.v1 && ctx.v1.user && ctx.v1.user.grants && ctx.v1.user.grants.grants) {
      ctx.v1.user.grants.grants.forEach(function(claim) {
        if (claim && claim.roles && claim.roles.length) {
          claim.roles.forEach(function(role) {
            if (rolesList.indexOf(role) === -1) {
              rolesList.push(role);
            }
          });
        }
      });
    }
    if (rolesList.length === 0 && ctx && ctx.v1 && ctx.v1.claims) {
      Object.keys(ctx.v1.claims).forEach(function(k) {
        if (k.indexOf(":roles") !== -1) {
          var val = ctx.v1.claims[k];
          if (typeof val === 'object' && val !== null) {
            Object.keys(val).forEach(function(r) {
              if (rolesList.indexOf(r) === -1) {
                rolesList.push(r);
              }
            });
          }
        }
      });
    }
    if (rolesList.length > 0) {
      api.v1.claims.setClaim('roles', rolesList);
    }
  } catch (e) {
    if (logger && logger.error) {
      logger.error("flatRoles error: " + e);
    }
  }
}"""

search_req = urllib.request.Request(
    f"{issuer}/management/v1/actions/_search",
    data=b"{}",
    headers=headers
)
with urllib.request.urlopen(search_req) as resp:
    actions = json.loads(resp.read().decode("utf-8")).get("result", [])

action_id = None
for a in actions:
    if a.get("name") == "flatRoles":
        action_id = a.get("id")
        break

payload = json.dumps({
    "id": action_id or "",
    "name": "flatRoles",
    "script": script,
    "timeout": "10s",
    "allowedToFail": True
}).encode("utf-8")

if action_id:
    up_req = urllib.request.Request(
        f"{issuer}/management/v1/actions/{action_id}",
        data=payload,
        headers=headers,
        method="PUT"
    )
    try:
        with urllib.request.urlopen(up_req) as resp:
            pass
    except urllib.error.HTTPError as e:
        err_body = e.read().decode("utf-8")
        if not any(code in err_body for code in ("ACTION-dg4t2", "COMMAND-Nfh52", "Sem alterações", "Nenhuma alteração")):
            print(f"Error in action update ({action_id}): {e.code} {err_body}", file=sys.stderr)
            raise
else:
    cr_req = urllib.request.Request(
        f"{issuer}/management/v1/actions",
        data=payload,
        headers=headers,
        method="POST"
    )
    with urllib.request.urlopen(cr_req) as resp:
        action_id = json.loads(resp.read().decode("utf-8"))["id"]

trig_payload = json.dumps({"actionIds": [action_id]}).encode("utf-8")
for trig_type in (4, 5):
    trig_req = urllib.request.Request(
        f"{issuer}/management/v1/flows/2/trigger/{trig_type}",
        data=trig_payload,
        headers=headers,
        method="POST"
    )
    try:
        with urllib.request.urlopen(trig_req) as resp:
            pass
    except urllib.error.HTTPError as e:
        err_body = e.read().decode("utf-8")
        if "COMMAND-Nfh52" not in err_body and "Sem alterações" not in err_body:
            print(f"Error in trigger {trig_type} setup: {e.code} {err_body}", file=sys.stderr)
            raise
EOF
}

