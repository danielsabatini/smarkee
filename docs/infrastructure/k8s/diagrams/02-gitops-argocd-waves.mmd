flowchart LR
    classDef git fill:#eceff1,stroke:#455a64,color:#1c2a30
    classDef argo fill:#ede7f6,stroke:#5e35b1,color:#1a0933
    classDef w0 fill:#ffebee,stroke:#c62828,color:#4a1010
    classDef w1 fill:#fff8e1,stroke:#ef6c00,color:#5a2d00
    classDef w2 fill:#e3f2fd,stroke:#1565c0,color:#0d2b4d
    classDef w3 fill:#e0f2f1,stroke:#00695c,color:#003d33
    classDef w4 fill:#e8f5e9,stroke:#2e7d32,color:#1b3d1f

    REPO[("Host Repository<br/>/workspace/smarkee (RO)")]:::git
    GITS["git-server (:9418)<br/>git://git-server.gitops-operator.svc.cluster.local:9418/smarkee.git<br/>branch: dev"]:::git
    ARGO["ArgoCD Application Controller<br/>+ argocd-repo-server (Kustomize)"]:::argo

    ROOT_PLAT["Application:<br/>smarkee-platform-root<br/>(prune + selfHeal)"]:::argo
    ROOT_FEAT["Application:<br/>smarkee-features-root<br/>(wave 4 · prune + selfHeal)"]:::argo

    subgraph WAVE0["Sync-Wave 0: Fundação de Segurança"]
        W0_VAULT["platform-vault<br/>OpenBao (svm/ekm/clm)<br/>ClusterIssuer · ClusterSecretStore · Bundle"]:::w0
    end

    subgraph WAVE1["Sync-Wave 1: Dados, Mensageria e E-mail"]
        W1_DB["platform-database<br/>CNPG PostgreSQL 18.6 (ssot + identity)"]:::w1
        W1_MSG["platform-messaging<br/>NATS JetStream + Streams (DESIRED/UPDATED/AUDIT)"]:::w1
        W1_MAIL["platform-mail<br/>Mailpit (:1025 / :8025)"]:::w1
    end

    subgraph WAVE2["Sync-Wave 2: Identidade e Telemetria"]
        W2_IDP["platform-identity<br/>Zitadel v4 (identity + identity-login)"]:::w2
        W2_TEL["platform-telemetry<br/>telemetry-agent · telemetry-router · telemetry-sink"]:::w2
    end

    subgraph WAVE3["Sync-Wave 3: Borda"]
        W3_GW["platform-gateway<br/>gateway-etcd · gateway (APISIX) · gateway-sync (ADC)"]:::w3
    end

    subgraph WAVE4["Sync-Wave 4: 9 Features de Produto"]
        W4_CORE["feature-core-account"]:::w4
        W4_BSM["feature-bsm-account"]:::w4
        W4_SUM["feature-sum-service"]:::w4
        W4_IPM["feature-ipm-{organization,user,<br/>serviceaccount,permission,role,group}"]:::w4
    end

    REPO -- "sync 10s" --> GITS
    GITS -- "git fetch" --> ARGO
    ARGO --> ROOT_PLAT
    ROOT_PLAT --> W0_VAULT
    W0_VAULT --> WAVE1
    WAVE1 --> WAVE2
    WAVE2 --> W3_GW
    W3_GW --> ROOT_FEAT
    ROOT_FEAT --> WAVE4
