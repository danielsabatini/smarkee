    classDef op fill:#ede7f6,stroke:#5e35b1,color:#1a0933
    classDef infra fill:#e3f2fd,stroke:#1565c0,color:#0d2b4d
    classDef app fill:#e8f5e9,stroke:#2e7d32,color:#1b3d1f
