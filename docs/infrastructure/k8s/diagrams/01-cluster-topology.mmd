    subgraph HOST["Host macOS (127.0.0.1) · Docker Desktop"]
        USER["Usuário / CLI sk<br/>http://127.0.0.1:8080"]:::host
        OPER["Operador / scripts/dev/*<br/>:5432 · :4222 · :8222 · :8025 · :8200 · :8443 · :9180"]:::host
        REG["smarkee-registry (registry:3.1.2)<br/>127.0.0.1:5001 ↔ smarkee-registry:5000"]:::reg
        MOUNTS[("Host Mounts (extraMounts)<br/>/workspace/smarkee (RO)<br/>infrastructure/dev/telemetry-sink/<br/>features/*/*/telemeter/")]:::host
