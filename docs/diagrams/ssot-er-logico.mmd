erDiagram
    RESOURCE ||--o{ IDEMPOTENCY : "resource_id (lógica, sem FK)"
    RESOURCE ||--o{ OUTBOX : "resource_id (lógica, sem FK)"

    RESOURCE {
        text resource_id PK "identidade estável do recurso"
        text lifecycle "present ou absent"
        text reconciliation "active ou suspended"
        jsonb desired "intenção (conteúdo do contrato)"
        bigint desired_generation "só muda com a especificação"
        bigint resource_version "controle otimista do solicitante"
        text requested_by "solicitante da geração vigente"
        text correlation_id "fluxo de rastreamento"
        jsonb observed "última observação"
        text presence "present, absent ou unknown"
        timestamptz observed_at "monotônico"
        text phase "Pending, Reconciling, Ready, Failed, Deleting"
        jsonb conditions "Ready e outras"
        int failure_count "falhas da geração corrente"
        bigint observed_generation "última geração confirmada pela observação"
    }
    IDEMPOTENCY {
        text requested_by PK "escopo do solicitante"
        text idempotency_key PK "chave informada pelo cliente"
        text request_digest "SHA-256 do conteúdo"
        text resource_id "recurso admitido"
        timestamptz created_at "retenção de 24 horas"
    }
    OUTBOX {
        bigint sequence PK "ordem de gravação"
        text message_id UK "messageId (deduplicação)"
        text resource_id "recurso da mensagem"
        text subject "desired ou updated.módulo.tipo.id"
        jsonb payload "envelope pronto"
        timestamptz published_at "nulo até a confirmação"
        text traceparent "W3C Trace Context, opcional"
    }
