flowchart LR
    classDef msg fill:#f3e5f5,stroke:#7b1fa2,color:#3a0f4a
    classDef tbl fill:#e0f2f1,stroke:#00695c,color:#003d33
    classDef who fill:#e8f5e9,stroke:#2e7d32,color:#1b3d1f

    HTTP["Requisição do cliente<br/>POST, PATCH ou DELETE"]:::msg
    API["API<br/>uma transação por requisição"]:::who

    CYC["Ciclo de reconciliação<br/>(observa, decide, age, reobserva)"]:::msg
    CTL["Controller<br/>uma transação por ciclo"]:::who

    R[("tipo<br/>(Resource)")]:::tbl
    I[("tipo_idempotency")]:::tbl
    X[("tipo_outbox")]:::tbl
    PUB["Publisher<br/>lê e marca published_at"]:::who
    BUS["NATS<br/>desired, updated"]:::msg

    HTTP --> API
    CYC --> CTL

    API -->|"INSERT ou UPDATE: desired, desired_generation, lifecycle"| R
    API -->|"INSERT: Idempotency-Key e request_digest"| I
    API -->|"INSERT: desired (emitter api)"| X
    CTL -->|"UPDATE: observed, presence, phase, conditions, failure_count, observed_generation; DELETE se ausência convergida"| R
    CTL -->|"INSERT: updated (emitter controller); desired suspenso no limite de falhas"| X
    X --> PUB --> BUS
