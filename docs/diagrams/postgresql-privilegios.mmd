flowchart LR
    classDef role fill:#e8f5e9,stroke:#2e7d32,color:#1b3d1f
    classDef tbl fill:#e0f2f1,stroke:#00695c,color:#003d33
    classDef view fill:#fff8e1,stroke:#ef6c00,color:#5a2d00

    API["tipo_api"]:::role
    CTL["tipo_controller<br/>(só external-reconciled)"]:::role
    P["tipo_publisher"]:::role
    MT["maintenance"]:::role

    R[("tipo")]:::tbl
    I[("tipo_idempotency")]:::tbl
    X[("tipo_outbox")]:::tbl
    V1["tipo_v1"]:::view

    API -->|"SELECT"| V1
    V1 -.->|"projeção"| R
    API -->|"INSERT UPDATE (campos de admissão)"| R
    API -->|"SELECT INSERT"| I
    API -->|"somente INSERT"| X
    CTL -->|"SELECT FOR UPDATE; UPDATE observação e convergência; DELETE após remoção confirmada"| R
    CTL -->|"somente INSERT"| X
    P -->|"SELECT; UPDATE published_at"| X
    MT -->|"SELECT DELETE (retenção)"| X
    MT -->|"SELECT DELETE (retenção)"| I
