flowchart LR
    classDef src fill:#eceff1,stroke:#455a64,color:#1c2a30
    classDef read fill:#ffebee,stroke:#c62828,color:#4a1010
    classDef route fill:#fff8e1,stroke:#ef6c00,color:#5a2d00
    classDef write fill:#e8f5e9,stroke:#2e7d32,color:#1b3d1f
    classDef out fill:#e0f2f1,stroke:#00695c,color:#003d33

    subgraph FONTES["Fontes (Kubernetes: dev, stg e prd · decisão 0102)"]
        APPS["Pods das 10 features<br/>(stdout CRI containerd, JSON do contrato 0045)"]:::src
        INFRA["Infra: database, messaging, identity,<br/>gateway, mail, telemetry, vault"]:::src
        APISIX["gateway (APISIX)<br/>(plugin opentelemetry: spans)"]:::src
    end

    AGENT["telemetry-agent (DaemonSet)<br/><b>LÊ</b><br/>/var/log/pods + kubeletstats"]:::read
    ROUTER["telemetry-router (StatefulSet)<br/><b>ROTEIA</b><br/>não grava em backend<br/>ajusta os spans à semconv"]:::route

    subgraph TELEMETERS["Telemeters (StatefulSets): processam e GRAVAM"]
        CAM["cam-account-telemeter<br/>logs e spans de cam/account"]:::write
        IPM["ipm-*-telemeter (6×)<br/>logs e spans de ipm/*"]:::write
        SUM["sum-service-telemeter &amp; bsm-*-telemeter (2×)<br/>logs e spans de sum/service e bsm/{account,payment}"]:::write
        SINK["telemetry-sink<br/>infra · app sem telemeter próprio"]:::write
    end

    OUTCAM[("features/cam/account/telemeter/<br/>logs/ · traces/")]:::out
    OUTIPM[("features/ipm/*/telemeter/<br/>logs/ · traces/")]:::out
    OUTSUM[("features/{sum/service,bsm/*}/telemeter/<br/>logs/ · traces/")]:::out
    OUTSINK[("infrastructure/dev/telemetry-sink/<br/>logs/{app,infra} · metrics/{app,infra} · traces/")]:::out

    APPS -- "/var/log/pods/*/*/*.log" --> AGENT
    INFRA -- "logs WARN+ · kubeletstats · métricas" --> AGENT
    AGENT -- "OTLP gRPC · fila em disco" --> ROUTER
    APISIX -- "OTLP HTTP" --> ROUTER
    ROUTER -- "logs: módulo e tipo<br/>spans: apisix.service_name" --> CAM
    ROUTER -- "idem" --> IPM
    ROUTER -- "idem" --> SUM
    ROUTER -- "todo o resto · métricas" --> SINK
    CAM --> OUTCAM
    IPM --> OUTIPM
    SUM --> OUTSUM
    SINK --> OUTSINK
