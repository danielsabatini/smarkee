{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IpmUserContracts",
  "description": "Índice dos contratos usados pelos componentes de user do módulo ipm: entrada do gerador de modelos (decisão 0012). Não é um contrato. Todo contrato de common/ e de ipm/user/ deve estar listado (verificado pelos testes de contrato). Uma definição que nenhum contrato referencia, mas que o código usa, entra pelo fragmento (#/$defs/...), como o catálogo grantableRole (decisão 0081).",
  "anyOf": [
    {
      "$ref": "common/message-envelope.v1.schema.json"
    },
    {
      "$ref": "common/condition.v1.schema.json"
    },
    {
      "$ref": "common/action.v1.schema.json"
    },
    {
      "$ref": "common/completed.v1.schema.json"
    },
    {
      "$ref": "common/failed.v1.schema.json"
    },
    {
      "$ref": "common/updated.v1.schema.json"
    },
    {
      "$ref": "common/operation.v1.schema.json"
    },
    {
      "$ref": "common/api-accepted-response.v1.schema.json"
    },
    {
      "$ref": "common/api-error.v1.schema.json"
    },
    {
      "$ref": "ipm/user/desired.v1.schema.json"
    },
    {
      "$ref": "ipm/user/observed.v1.schema.json"
    },
    {
      "$ref": "ipm/user/requested-create.v1.schema.json"
    },
    {
      "$ref": "ipm/user/requested-delete.v1.schema.json"
    },
    {
      "$ref": "ipm/user/requested-update.v1.schema.json"
    },
    {
      "$ref": "ipm/user/api-create-request.v1.schema.json"
    },
    {
      "$ref": "ipm/user/api-update-request.v1.schema.json"
    },
    {
      "$ref": "ipm/user/resource.v1.schema.json"
    },
    {
      "$ref": "ipm/user/resource-list.v1.schema.json"
    },
    {
      "$ref": "ipm/definitions.v1.schema.json#/$defs/grantableRole"
    }
  ]
}
