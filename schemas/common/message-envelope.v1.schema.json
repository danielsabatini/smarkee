{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MessageEnvelope",
  "description": "Metadados de transporte e rastreamento de toda mensagem (MESSAGING.md, Campos do envelope). O conteúdo de data é validado pelo contrato do messageType e do tipo de recurso. O tamanho de data é limitado a 256 KiB.",
  "x-schemaVersion": "1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "messageId",
    "schemaVersion",
    "messageType",
    "emitter",
    "module",
    "resourceType",
    "resourceId",
    "operation",
    "occurredAt",
    "publishedAt",
    "data"
  ],
  "properties": {
    "messageId": {
      "$ref": "definitions.v1.schema.json#/$defs/opaqueIdentifier",
      "description": "Identidade única da mensagem; também a chave de deduplicação do transporte.",
      "x-writer": "server",
      "x-sensitivity": "internal"
    },
    "schemaVersion": {
      "description": "Versão MAJOR.MINOR do contrato da mensagem (envelope e data).",
      "type": "string",
      "maxLength": 16,
      "pattern": "^[0-9]{1,4}\\.[0-9]{1,4}$",
      "x-writer": "server",
      "x-sensitivity": "internal"
    },
    "messageType": {
      "title": "MessageType",
      "description": "Tipo semântico da mensagem.",
      "type": "string",
      "enum": [
        "requested",
        "desired",
        "observed",
        "action",
        "completed",
        "failed",
        "updated"
      ],
      "x-enumPolicy": "closed",
      "x-writer": "server",
      "x-sensitivity": "internal"
    },
    "emitter": {
      "title": "MessageEmitter",
      "description": "Emissor lógico (identidade funcional, não a instância).",
      "type": "string",
      "enum": [
        "api",
        "manager",
        "observer",
        "reconciler",
        "executor"
      ],
      "x-enumPolicy": "closed",
      "x-writer": "server",
      "x-sensitivity": "internal"
    },
    "module": {
      "description": "Módulo funcional ao qual a mensagem pertence (token do subject).",
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9-]*$",
      "x-writer": "server",
      "x-sensitivity": "internal"
    },
    "resourceType": {
      "description": "Tipo de recurso (token do subject).",
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9-]*$",
      "x-writer": "server",
      "x-sensitivity": "internal"
    },
    "resourceId": {
      "$ref": "definitions.v1.schema.json#/$defs/resourceId",
      "x-writer": "server",
      "x-sensitivity": "internal"
    },
    "operation": {
      "title": "MessageOperation",
      "description": "Operação ou resultado semântico associado. desired, observed e updated usam changed.",
      "type": "string",
      "enum": [
        "create",
        "update",
        "delete",
        "changed",
        "reconcile",
        "noop"
      ],
      "x-enumPolicy": "open",
      "x-writer": "server",
      "x-sensitivity": "internal"
    },
    "desiredGeneration": {
      "$ref": "definitions.v1.schema.json#/$defs/generation",
      "x-writer": "server",
      "x-sensitivity": "internal"
    },
    "observedGeneration": {
      "$ref": "definitions.v1.schema.json#/$defs/generation",
      "description": "Geração desejada à qual a observação se relaciona; não é preenchida artificialmente.",
      "x-writer": "server",
      "x-sensitivity": "internal"
    },
    "presence": {
      "$ref": "definitions.v1.schema.json#/$defs/presence",
      "x-writer": "server",
      "x-sensitivity": "internal"
    },
    "actionId": {
      "$ref": "definitions.v1.schema.json#/$defs/actionId",
      "x-writer": "server",
      "x-sensitivity": "internal"
    },
    "requestedBy": {
      "$ref": "definitions.v1.schema.json#/$defs/actorId",
      "x-writer": "server",
      "x-sensitivity": "internal"
    },
    "correlationId": {
      "$ref": "definitions.v1.schema.json#/$defs/opaqueIdentifier",
      "x-writer": "server",
      "x-sensitivity": "internal"
    },
    "causationId": {
      "$ref": "definitions.v1.schema.json#/$defs/opaqueIdentifier",
      "description": "messageId da mensagem que causou esta.",
      "x-writer": "server",
      "x-sensitivity": "internal"
    },
    "occurredAt": {
      "$ref": "definitions.v1.schema.json#/$defs/timestamp",
      "x-writer": "server",
      "x-sensitivity": "internal"
    },
    "publishedAt": {
      "$ref": "definitions.v1.schema.json#/$defs/timestamp",
      "x-writer": "server",
      "x-sensitivity": "internal"
    },
    "observedAt": {
      "$ref": "definitions.v1.schema.json#/$defs/timestamp",
      "x-writer": "server",
      "x-sensitivity": "internal"
    },
    "data": {
      "description": "Conteúdo específico do messageType e do tipo de recurso, validado pelo respectivo contrato.",
      "type": "object",
      "maxProperties": 64,
      "x-writer": "server",
      "x-sensitivity": "internal"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "messageType": {
            "const": "requested"
          }
        }
      },
      "then": {
        "required": [
          "requestedBy",
          "correlationId"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "messageType": {
            "const": "desired"
          }
        }
      },
      "then": {
        "required": [
          "desiredGeneration"
        ],
        "properties": {
          "operation": {
            "const": "changed"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "messageType": {
            "const": "observed"
          }
        }
      },
      "then": {
        "required": [
          "presence",
          "observedAt"
        ],
        "properties": {
          "operation": {
            "const": "changed"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "messageType": {
            "enum": [
              "action",
              "completed",
              "failed"
            ]
          }
        }
      },
      "then": {
        "required": [
          "actionId",
          "desiredGeneration",
          "causationId"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "messageType": {
            "const": "updated"
          }
        }
      },
      "then": {
        "properties": {
          "operation": {
            "const": "changed"
          }
        }
      }
    }
  ]
}
