{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IpmServiceaccountContracts",
  "description": "Índice dos contratos usados pelos componentes de serviceaccount do módulo ipm: entrada do gerador de modelos (decisão 0012). Não é um contrato. Todo contrato de common/ e de ipm/serviceaccount/ deve estar listado (verificado pelos testes de contrato). Uma definição que nenhum contrato referencia, mas que o código usa, entra pelo fragmento (#/$defs/...), como o catálogo grantablePermission (decisão 0081).",
  "anyOf": [
    {
      "$ref": "common/message-envelope.v1.schema.json"
    },
    {
      "$ref": "common/condition.v1.schema.json"
    },
    {
      "$ref": "common/action.v1.schema.json"
    },
    {
      "$ref": "common/completed.v1.schema.json"
    },
    {
      "$ref": "common/failed.v1.schema.json"
    },
    {
      "$ref": "common/updated.v1.schema.json"
    },
    {
      "$ref": "common/api-error.v1.schema.json"
    },
    {
      "$ref": "ipm/serviceaccount/desired.v1.schema.json"
    },
    {
      "$ref": "ipm/serviceaccount/observed.v1.schema.json"
    },
    {
      "$ref": "ipm/serviceaccount/api-create-request.v1.schema.json"
    },
    {
      "$ref": "ipm/serviceaccount/api-update-request.v1.schema.json"
    },
    {
      "$ref": "ipm/serviceaccount/resource.v1.schema.json"
    },
    {
      "$ref": "ipm/serviceaccount/resource-list.v1.schema.json"
    },
    {
      "$ref": "ipm/definitions.v1.schema.json#/$defs/grantablePermission"
    }
  ]
}
