{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RoleCreateRequest",
  "description": "Corpo de POST /v1/ipm/roles. A API atribui resourceId e requestedBy, além de roleType = custom e deletionProtection = true (decisões 0092 e 0098).",
  "x-schemaVersion": "1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "organizationId",
    "name",
    "description",
    "permissions"
  ],
  "properties": {
    "organizationId": {
      "$ref": "../../common/definitions.v1.schema.json#/$defs/resourceId",
      "description": "Organization dona da Role (o resourceId da Organization). Imutável. A Organization de sistema `core` é reservada às Roles predefinidas.",
      "x-writer": "client",
      "x-sensitivity": "internal"
    },
    "name": {
      "$ref": "definitions.v1.schema.json#/$defs/roleName",
      "x-writer": "client",
      "x-sensitivity": "public"
    },
    "description": {
      "$ref": "definitions.v1.schema.json#/$defs/description",
      "x-writer": "client",
      "x-sensitivity": "public"
    },
    "permissions": {
      "$ref": "definitions.v1.schema.json#/$defs/permissions",
      "x-writer": "client",
      "x-sensitivity": "internal"
    }
  }
}
