{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GroupCreateRequest",
  "description": "Corpo de POST /v1/ipm/groups. O Receiver atribui resourceId, operationId, requestDigest e requestedBy. roles ausente equivale a nenhuma; deletionProtection ausente equivale a false (decisão 0088).",
  "x-schemaVersion": "1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "organizationId",
    "name",
    "description"
  ],
  "properties": {
    "organizationId": {
      "$ref": "../../common/definitions.v1.schema.json#/$defs/resourceId",
      "description": "Organization onde o grupo vive (o resourceId da Organization). Imutável.",
      "x-writer": "client",
      "x-sensitivity": "internal"
    },
    "name": {
      "$ref": "definitions.v1.schema.json#/$defs/groupName",
      "x-writer": "client",
      "x-sensitivity": "public"
    },
    "description": {
      "$ref": "definitions.v1.schema.json#/$defs/description",
      "x-writer": "client",
      "x-sensitivity": "public"
    },
    "roles": {
      "$ref": "definitions.v1.schema.json#/$defs/roles",
      "x-writer": "client",
      "x-sensitivity": "internal"
    },
    "deletionProtection": {
      "$ref": "../../common/definitions.v1.schema.json#/$defs/deletionProtection",
      "x-writer": "client",
      "x-sensitivity": "internal"
    }
  }
}
