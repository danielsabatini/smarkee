{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UserUpdateRequest",
  "description": "Corpo de PATCH /v1/ipm/users/{resourceId}. resourceVersion é a versão lida; pelo menos um campo deve ser alterado. Mudar permissions exige ipm.user.bind, ou só permissões que quem pede já tem (decisão 0077); reconciliation é do operador.",
  "x-schemaVersion": "1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "resourceVersion"
  ],
  "minProperties": 2,
  "properties": {
    "resourceVersion": {
      "$ref": "../../common/definitions.v1.schema.json#/$defs/resourceVersion",
      "x-writer": "client",
      "x-sensitivity": "internal"
    },
    "permissions": {
      "$ref": "definitions.v1.schema.json#/$defs/permissions",
      "x-writer": "client",
      "x-sensitivity": "internal"
    },
    "roles": {
      "$ref": "definitions.v1.schema.json#/$defs/roles",
      "x-writer": "client",
      "x-sensitivity": "internal"
    },
    "deletionProtection": {
      "$ref": "../../common/definitions.v1.schema.json#/$defs/deletionProtection",
      "x-writer": "client",
      "x-sensitivity": "internal"
    },
    "reconciliation": {
      "$ref": "../../common/definitions.v1.schema.json#/$defs/reconciliation",
      "x-writer": "client",
      "x-sensitivity": "internal"
    }
  }
}
