{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UserCreateRequest",
  "description": "Corpo de POST /v1/ipm/users. O Receiver atribui resourceId, operationId, requestDigest e requestedBy. Não há senha: a pessoa a define na página do provedor de identidade, pelo e-mail de ativação. roles ausente equivale a nenhuma; deletionProtection ausente equivale a false (decisão 0077, 0085).",
  "x-schemaVersion": "1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "organizationId",
    "givenName",
    "familyName",
    "email"
  ],
  "properties": {
    "organizationId": {
      "$ref": "../../common/definitions.v1.schema.json#/$defs/resourceId",
      "x-writer": "client",
      "x-sensitivity": "internal"
    },
    "givenName": {
      "$ref": "definitions.v1.schema.json#/$defs/givenName",
      "x-writer": "client",
      "x-sensitivity": "confidential"
    },
    "familyName": {
      "$ref": "definitions.v1.schema.json#/$defs/familyName",
      "x-writer": "client",
      "x-sensitivity": "confidential"
    },
    "email": {
      "$ref": "definitions.v1.schema.json#/$defs/email",
      "x-writer": "client",
      "x-sensitivity": "confidential"
    },
    "roles": {
      "$ref": "definitions.v1.schema.json#/$defs/roles",
      "x-writer": "client",
      "x-sensitivity": "internal"
    },
    "groups": {
      "$ref": "definitions.v1.schema.json#/$defs/groups",
      "x-writer": "client",
      "x-sensitivity": "internal"
    },
    "deletionProtection": {
      "$ref": "../../common/definitions.v1.schema.json#/$defs/deletionProtection",
      "x-writer": "client",
      "x-sensitivity": "internal"
    }
  }
}
