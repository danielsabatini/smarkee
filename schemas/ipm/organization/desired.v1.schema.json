{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OrganizationDesiredData",
  "description": "data de desired da Organization: estado pretendido e controle de reconciliação. Publicado somente pelo Manager. Não carrega dados pessoais.",
  "x-schemaVersion": "1.0",
  "x-resourceParameters": {
    "observationInterval": "PT5M",
    "observationValidity": "PT10M",
    "actionDeadline": "PT2M",
    "failureLimit": 5,
    "progressDeadline": "PT5M"
  },
  "x-actionIdFormat": "<resourceId>.<desiredGeneration>.<operation>.<messageId do observed que motivou a decisão>",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lifecycle",
    "reconciliation",
    "name",
    "platformAccess",
    "ownerAccountId"
  ],
  "properties": {
    "lifecycle": {
      "$ref": "../../common/definitions.v1.schema.json#/$defs/lifecycle",
      "x-writer": "server",
      "x-mutability": "mutable",
      "x-managed": true,
      "x-sensitivity": "internal"
    },
    "reconciliation": {
      "$ref": "../../common/definitions.v1.schema.json#/$defs/reconciliation",
      "x-writer": "server",
      "x-mutability": "mutable",
      "x-managed": false,
      "x-sensitivity": "internal"
    },
    "name": {
      "$ref": "definitions.v1.schema.json#/$defs/organizationName",
      "x-writer": "client",
      "x-mutability": "mutable",
      "x-managed": true,
      "x-sensitivity": "public"
    },
    "platformAccess": {
      "$ref": "../../common/definitions.v1.schema.json#/$defs/platformAccess",
      "x-writer": "client",
      "x-mutability": "mutable",
      "x-managed": true,
      "x-sensitivity": "internal"
    },
    "deletionProtection": {
      "$ref": "../../common/definitions.v1.schema.json#/$defs/deletionProtection",
      "x-writer": "client",
      "x-mutability": "mutable",
      "x-managed": true,
      "x-sensitivity": "internal"
    },
    "userAccess": {
      "$ref": "definitions.v1.schema.json#/$defs/userAccess",
      "description": "Preparo da organização para os usuários dela (decisão 0081). Reconciliado enquanto platformAccess é granted. Ausente só em desired gravado antes da decisão 0081: o rollout do Manager o acrescenta.",
      "x-writer": "server",
      "x-mutability": "mutable",
      "x-managed": true,
      "x-sensitivity": "internal"
    },
    "ownerAccountId": {
      "$ref": "../../common/definitions.v1.schema.json#/$defs/resourceId",
      "description": "Dono da Organization: resourceId da Account autenticado que a criou (sub do token). Atribuído pelo Manager a partir de requestedBy no create; imutável.",
      "x-writer": "server",
      "x-mutability": "immutable",
      "x-managed": false,
      "x-sensitivity": "internal"
    },
    "billingAccountId": {
      "$ref": "../../common/definitions.v1.schema.json#/$defs/resourceId",
      "description": "Conta de faturamento (bsm.account) responsável pelos custos desta Organization (BillingAccountId no FOCUS 1.4). Opcional enquanto o vínculo não for obrigatório.",
      "x-writer": "client",
      "x-mutability": "mutable",
      "x-managed": false,
      "x-sensitivity": "internal"
    }
  }
}
