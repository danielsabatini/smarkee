{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IpmPermissionContracts",
  "description": "Índice dos contratos usados pelos componentes de permission do módulo ipm: entrada do gerador de modelos (decisão 0012). Não é um contrato. Todo contrato de common/ e de ipm/permission/ deve estar listado (verificado pelos testes de contrato).",
  "anyOf": [
    {
      "$ref": "common/message-envelope.v1.schema.json"
    },
    {
      "$ref": "common/condition.v1.schema.json"
    },
    {
      "$ref": "common/action.v1.schema.json"
    },
    {
      "$ref": "common/completed.v1.schema.json"
    },
    {
      "$ref": "common/failed.v1.schema.json"
    },
    {
      "$ref": "common/updated.v1.schema.json"
    },
    {
      "$ref": "common/api-error.v1.schema.json"
    },
    {
      "$ref": "ipm/permission/desired.v1.schema.json"
    },
    {
      "$ref": "ipm/permission/observed.v1.schema.json"
    },
    {
      "$ref": "ipm/permission/api-create-request.v1.schema.json"
    },
    {
      "$ref": "ipm/permission/api-update-request.v1.schema.json"
    },
    {
      "$ref": "ipm/permission/resource.v1.schema.json"
    },
    {
      "$ref": "ipm/permission/resource-list.v1.schema.json"
    }
  ]
}
