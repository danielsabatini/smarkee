{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ServiceRequestedCreateData",
  "description": "data de requested com operation create: pede a ligação de um serviço para o dono. Publicado somente pelo Receiver, a partir do token do solicitante (decisão 0033). O Manager decide se a ligação é aceita, pelo catálogo e pela unicidade do par dono + serviço.",
  "x-schemaVersion": "1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operationId",
    "requestDigest",
    "specification"
  ],
  "properties": {
    "operationId": {
      "$ref": "../../common/definitions.v1.schema.json#/$defs/opaqueIdentifier",
      "x-writer": "server",
      "x-sensitivity": "internal"
    },
    "requestDigest": {
      "$ref": "../../common/definitions.v1.schema.json#/$defs/requestDigest",
      "x-writer": "server",
      "x-sensitivity": "internal"
    },
    "specification": {
      "title": "ServiceCreateSpecification",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service",
        "ownerUserId"
      ],
      "x-writer": "server",
      "x-sensitivity": "internal",
      "properties": {
        "service": {
          "$ref": "definitions.v1.schema.json#/$defs/service",
          "x-writer": "client",
          "x-sensitivity": "internal"
        },
        "ownerUserId": {
          "$ref": "../../common/definitions.v1.schema.json#/$defs/resourceId",
          "description": "Dono da ligação: o `sub` do token do solicitante, atribuído pelo Receiver.",
          "x-writer": "server",
          "x-sensitivity": "internal"
        }
      }
    }
  }
}
