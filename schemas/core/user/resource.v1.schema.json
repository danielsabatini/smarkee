{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "User",
  "description": "Visão consolidada do User exposta pela API (GET /v1/users/{resourceId}), legível pelo próprio usuário e por operadores. Não expõe campos internos do SSOT (failureCount, requestedBy).",
  "x-schemaVersion": "1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "resourceId",
    "resourceVersion",
    "desiredGeneration",
    "phase",
    "conditions",
    "desired",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "resourceId": {
      "$ref": "../../common/definitions.v1.schema.json#/$defs/resourceId",
      "description": "Também o ID do usuário no provedor de identidade (decisão 0014).",
      "x-writer": "server",
      "x-sensitivity": "internal"
    },
    "resourceVersion": {
      "$ref": "../../common/definitions.v1.schema.json#/$defs/resourceVersion",
      "x-writer": "server",
      "x-sensitivity": "internal"
    },
    "desiredGeneration": {
      "$ref": "../../common/definitions.v1.schema.json#/$defs/generation",
      "x-writer": "server",
      "x-sensitivity": "internal"
    },
    "phase": {
      "$ref": "../../common/definitions.v1.schema.json#/$defs/phase",
      "x-writer": "server",
      "x-sensitivity": "public"
    },
    "conditions": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "../../common/condition.v1.schema.json"
      },
      "x-writer": "server",
      "x-sensitivity": "internal"
    },
    "desired": {
      "title": "UserDesiredView",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lifecycle",
        "reconciliation",
        "platformAccess"
      ],
      "x-writer": "server",
      "x-sensitivity": "confidential",
      "properties": {
        "lifecycle": {
          "$ref": "../../common/definitions.v1.schema.json#/$defs/lifecycle",
          "x-writer": "server",
          "x-sensitivity": "internal"
        },
        "reconciliation": {
          "$ref": "../../common/definitions.v1.schema.json#/$defs/reconciliation",
          "x-writer": "server",
          "x-sensitivity": "internal"
        },
        "platformAccess": {
          "$ref": "../../common/definitions.v1.schema.json#/$defs/platformAccess",
          "x-writer": "server",
          "x-sensitivity": "internal"
        },
        "givenName": {
          "$ref": "definitions.v1.schema.json#/$defs/givenName",
          "x-writer": "server",
          "x-sensitivity": "confidential"
        },
        "familyName": {
          "$ref": "definitions.v1.schema.json#/$defs/familyName",
          "x-writer": "server",
          "x-sensitivity": "confidential"
        },
        "email": {
          "$ref": "definitions.v1.schema.json#/$defs/email",
          "x-writer": "server",
          "x-sensitivity": "confidential"
        }
      }
    },
    "observed": {
      "title": "UserObservedView",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "presence",
        "observedAt"
      ],
      "description": "Última observação; ausente antes da primeira.",
      "x-writer": "server",
      "x-sensitivity": "internal",
      "properties": {
        "presence": {
          "$ref": "../../common/definitions.v1.schema.json#/$defs/presence",
          "x-writer": "server",
          "x-sensitivity": "internal"
        },
        "observedAt": {
          "$ref": "../../common/definitions.v1.schema.json#/$defs/timestamp",
          "x-writer": "server",
          "x-sensitivity": "internal"
        },
        "emailVerified": {
          "type": "boolean",
          "x-writer": "server",
          "x-sensitivity": "internal"
        },
        "userState": {
          "$ref": "definitions.v1.schema.json#/$defs/userState",
          "x-writer": "server",
          "x-sensitivity": "internal"
        },
        "platformAccess": {
          "$ref": "../../common/definitions.v1.schema.json#/$defs/platformAccess",
          "x-writer": "server",
          "x-sensitivity": "internal"
        }
      }
    },
    "createdAt": {
      "$ref": "../../common/definitions.v1.schema.json#/$defs/timestamp",
      "x-writer": "server",
      "x-sensitivity": "internal"
    },
    "updatedAt": {
      "$ref": "../../common/definitions.v1.schema.json#/$defs/timestamp",
      "x-writer": "server",
      "x-sensitivity": "internal"
    }
  }
}
