# Componentes @@KEBAB@@ (api, publisher e controller). Copie para .env (fora do git) e preencha o
# que está vazio.

# Senhas dos papéis de login do SSOT. Em dev são triviais e iguais ao nome do papel
# (infrastructure/dev/database/bootstrap/@@MODULE@@.sql). Em stg e prd, vêm da gestão de segredos.
@@UPPER@@_API_DATABASE_PASSWORD=@@PACKAGE@@_api_login
@@UPPER@@_PUBLISHER_DATABASE_PASSWORD=@@PACKAGE@@_publisher_login
@@UPPER@@_CONTROLLER_DATABASE_PASSWORD=@@PACKAGE@@_controller_login

# Obrigatório. A mesma SMARKEE_MESSAGING_PASSWORD de messaging/.env (em dev, um único usuário no NATS).
@@UPPER@@_API_MESSAGING_PASSWORD=
@@UPPER@@_PUBLISHER_MESSAGING_PASSWORD=
@@UPPER@@_CONTROLLER_MESSAGING_PASSWORD=

# Obrigatório. ID do projeto `roles-@@MODULE@@` (organização `core` do Zitadel): é a audience dos tokens aceitos
# pela API.
@@UPPER@@_API_AUTH_AUDIENCE=

# Obrigatórios para o Controller, quando o recurso usa o Zitadel. A organização `register` (usuários) e, por
# módulo, o projeto de roles que ele concede (JSON; só os módulos em que ele é `PROJECT_GRANT_OWNER`, decisão
# 0032): @@UPPER@@_IDENTITY_PROJECT_IDS={"@@MODULE@@":"<ID de roles-@@MODULE@@>"}
@@UPPER@@_IDENTITY_REGISTER_ORGANIZATION_ID=
@@UPPER@@_IDENTITY_PROJECT_IDS=

# Opcionais (têm default no compose.yaml; descomente só para mudar).
# Imagem única da feature, construída localmente (decisão 0063).
# @@UPPER@@_IMAGE=smarkee-@@KEBAB@@:dev
# Limite de CPU de cada um dos papéis.
# @@UPPER@@_COMPONENT_CPUS=0.5
# Limite de memória de cada um dos papéis.
# @@UPPER@@_COMPONENT_MEMORY=256M
# Limite de CPU do telemeter da feature.
# @@UPPER@@_TELEMETER_CPUS=0.25
# Limite de memória do telemeter da feature.
# @@UPPER@@_TELEMETER_MEMORY=192M
# Ambiente informado à telemetria (dev, stg, prd).
# SMARKEE_ENVIRONMENT=dev
# Imagem do coletor, a mesma da infraestrutura.
# SMARKEE_TELEMETRY_IMAGE_VERSION=otel/opentelemetry-collector-contrib:0.163.1
# Imagem do cliente psql (infrastructure/tools).
# SMARKEE_DATABASE_CLIENT_IMAGE=smarkee-psql-client:dev
# Usuário do NATS (o mesmo de messaging/.env).
# SMARKEE_MESSAGING_USER=smarkee

# Execução local (fora do Docker): `uv run --env-file .env <comando>` contra as portas publicadas pela
# infraestrutura. O ambiente vence o config.toml, e o compose só repassa as variáveis que lista, então
# estas linhas não afetam os contêineres. Descomente e ajuste por papel (exemplo: api).
# @@UPPER@@_API_DATABASE_HOST=localhost
# @@UPPER@@_API_DATABASE_PORT=5432
# @@UPPER@@_API_DATABASE_NAME=ssot
# @@UPPER@@_API_DATABASE_USER=@@PACKAGE@@_api_login
# @@UPPER@@_API_MESSAGING_URL=nats://localhost:4222
# @@UPPER@@_API_MESSAGING_USER=smarkee
