# Componentes @@KEBAB@@ (receiver, manager, publisher, reconciler, observer e executor). Copie para .env (fora do git) e preencha o
# que está vazio.

# Senhas dos papéis de login do SSOT. Em dev são triviais e iguais ao nome do papel
# (infrastructure/dev/database/bootstrap/@@MODULE@@.sql). Em stg e prd, vêm da gestão de segredos.
@@UPPER@@_RECEIVER_DATABASE_PASSWORD=@@PACKAGE@@_receiver_login
@@UPPER@@_MANAGER_DATABASE_PASSWORD=@@PACKAGE@@_manager_login
@@UPPER@@_PUBLISHER_DATABASE_PASSWORD=@@PACKAGE@@_publisher_login

# Obrigatório. A mesma SMARKEE_MESSAGING_PASSWORD de messaging/.env (em dev, um único usuário no NATS).
@@UPPER@@_RECEIVER_MESSAGING_PASSWORD=
@@UPPER@@_MANAGER_MESSAGING_PASSWORD=
@@UPPER@@_PUBLISHER_MESSAGING_PASSWORD=
@@UPPER@@_RECONCILER_MESSAGING_PASSWORD=

# Obrigatório. ID do projeto `roles-@@MODULE@@` (organização `core` do Zitadel): é a audience dos tokens.
@@UPPER@@_RECEIVER_AUTH_AUDIENCE=

# Observer e Executor: senha do NATS (a mesma SMARKEE_MESSAGING_PASSWORD de messaging/.env).
@@UPPER@@_OBSERVER_MESSAGING_PASSWORD=
@@UPPER@@_EXECUTOR_MESSAGING_PASSWORD=

# Obrigatórios. IDs no Zitadel: organização `register` (usuários cadastrados) e, por módulo, o projeto
# de roles que o Executor concede (JSON; só os módulos em que ele é `PROJECT_GRANT_OWNER`, decisão 0032):
# @@UPPER@@_IDENTITY_PROJECT_IDS={"core":"<ID de roles-@@MODULE@@>","sum":"<ID de roles-sum>"}
@@UPPER@@_IDENTITY_REGISTER_ORGANIZATION_ID=
@@UPPER@@_IDENTITY_PROJECT_IDS=

# Opcionais (têm default no compose.yaml): tags das imagens construídas localmente e das imagens de apoio.
# @@UPPER@@_IMAGE (imagem única da feature, decisão 0063),
# SMARKEE_DATABASE_CLIENT_IMAGE, SMARKEE_MESSAGING_CLIENT_IMAGE (imagens de `infrastructure/tools`), SMARKEE_MESSAGING_USER

# Execução local (fora do Docker): `uv run --env-file .env <comando>` contra as portas publicadas pela
# infraestrutura. O ambiente vence o config.toml, e o compose só repassa as variáveis que lista, então
# estas linhas não afetam os contêineres. Descomente e ajuste por papel (exemplo: receiver).
# @@UPPER@@_RECEIVER_DATABASE_HOST=localhost
# @@UPPER@@_RECEIVER_DATABASE_PORT=5432
# @@UPPER@@_RECEIVER_DATABASE_NAME=smarkee
# @@UPPER@@_RECEIVER_DATABASE_USER=@@PACKAGE@@_receiver_login
# @@UPPER@@_RECEIVER_MESSAGING_URL=nats://localhost:4222
# @@UPPER@@_RECEIVER_MESSAGING_USER=smarkee
