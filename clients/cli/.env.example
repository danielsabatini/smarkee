# Sobrescritas de desenvolvimento da CLI `sk`. Copie para .env (fora do git) e, antes de usar a CLI:
#   source .env
#
# Em produção a CLI não precisa de nada disto: os valores da plataforma são o padrão (decisão 0036).
# Aqui entram só os valores do ambiente de desenvolvimento. Nada é segredo: são endereços e IDs
# públicos. Os IDs vêm do Zitadel de dev (console ou `infrastructure/dev/README.md`).

# Provedor de identidade (Zitadel pelo gateway) e a aplicação `cli` do projeto `clients`.
export SK_AUTH_ISSUER=http://ipm-dev.smarkee.com.br:8080
export SK_AUTH_CLIENT_ID=<client ID da aplicação cli>
export SK_AUTH_ALLOW_INSECURE_HTTP=true   # dev não tem TLS

# API da plataforma (gateway), usada por todos os módulos.
export SK_API_URL=http://api-dev.smarkee.com.br:8080
export SK_API_ALLOW_INSECURE_HTTP=true    # dev não tem TLS

# Projetos de roles dos módulos: o login pede a audience de cada um (decisão 0034).
export SK_CORE_PROJECT_ID=<ID de roles-core>
export SK_SUM_PROJECT_ID=<ID de roles-sum>
export SK_IPM_PROJECT_ID=<ID de roles-ipm>
