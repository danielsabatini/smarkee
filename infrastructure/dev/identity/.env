# Imagem do Zitadel
ZITADEL_IMAGE_VERSION=ghcr.io/zitadel/zitadel:v2.66.1

# Zitadel Setup
ZITADEL_MASTERKEY=a-32-byte-long-secret-key-change-me
ZITADEL_MACHINEKEY=a-32-byte-long-secret-key-change-me

# Database Info (Reutilizando a rede e o banco já criado)
ZITADEL_DATABASE_HOST=smarkee-database
ZITADEL_DATABASE_PORT=5432
ZITADEL_DATABASE_USER=smarkee
ZITADEL_DATABASE_PASSWORD=smarkee_password
ZITADEL_DATABASE_NAME=smarkee
