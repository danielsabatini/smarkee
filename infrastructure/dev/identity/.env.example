# Imagem do Zitadel
ZITADEL_IMAGE_VERSION=ghcr.io/zitadel/zitadel:v4.19.4

# Obrigatório. Exatamente 32 caracteres. Gere com: openssl rand -hex 16
# Não altere depois da primeira inicialização (cifra dados em repouso).
ZITADEL_MASTERKEY=

# Banco de dados (serviço `database`, mesma rede internal)
ZITADEL_DATABASE_HOST=database
ZITADEL_DATABASE_PORT=5432
ZITADEL_DATABASE_NAME=zitadel
ZITADEL_DATABASE_USER=zitadel
# Obrigatório. Senha do usuário de aplicação do Zitadel (dev: igual ao nome do usuário).
ZITADEL_DATABASE_PASSWORD=zitadel

# Administrador do PostgreSQL (mesmos valores de database/.env), usado só no init.
POSTGRES_ADMIN_USER=smarkee
POSTGRES_ADMIN_PASSWORD=

# Obrigatório. Senha inicial do administrador do Zitadel (exige maiúscula, minúscula,
# número e símbolo; troca obrigatória no primeiro acesso). Usuário padrão: zitadel-admin@zitadel.localhost
ZITADEL_ADMIN_PASSWORD=

# Porta pela qual os clientes acessam o Zitadel (porta do proxy HTTP do gateway).
# Define o issuer/URLs do Zitadel; alterar exige reinicializar a instância.
ZITADEL_EXTERNAL_PORT=8000

# Imagem do login v2 (use a mesma versão do Zitadel).
ZITADEL_LOGIN_IMAGE_VERSION=ghcr.io/zitadel/zitadel-login:v4.19.4
# Validade do PAT do cliente de login (ISO 8601).
ZITADEL_LOGIN_CLIENT_PAT_EXPIRATION=2030-01-01T00:00:00Z
# Obrigatório. Segredo do cookie de sessão do login. Gere com: openssl rand -hex 32
ZITADEL_LOGIN_SESSION_COOKIE_SECRET=
