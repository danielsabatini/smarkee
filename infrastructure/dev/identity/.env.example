# Imagem do Zitadel
ZITADEL_IMAGE_VERSION=ghcr.io/zitadel/zitadel:v4.19.4

# Obrigatório. Exatamente 32 caracteres. Gere com: openssl rand -hex 16
# Não altere depois da primeira inicialização (cifra dados em repouso).
ZITADEL_MASTERKEY=

# Banco de dados (serviço `database`, mesma rede internal)
ZITADEL_DATABASE_POSTGRES_HOST=database.smarkee.internal
ZITADEL_DATABASE_POSTGRES_PORT=5432
ZITADEL_DATABASE_POSTGRES_DATABASE=identity
ZITADEL_DATABASE_POSTGRES_USER_USERNAME=identity
# Obrigatório. Senha do usuário do Zitadel, criado por database/bootstrap/identity.sql (dev: igual ao nome do usuário).
ZITADEL_DATABASE_POSTGRES_USER_PASSWORD=identity

# Primeira instância: nome exibido no console (forma curta de Identity Provider Manager)
ZITADEL_FIRSTINSTANCE_INSTANCENAME=IPM

# Primeira instância: organização inicial e administrador humano
ZITADEL_FIRSTINSTANCE_ORG_NAME=smarkee.internal
ZITADEL_FIRSTINSTANCE_ORG_HUMAN_USERNAME=admin
# Obrigatório. Senha inicial do administrador do Zitadel (exige maiúscula, minúscula,
# número e símbolo; troca obrigatória no primeiro acesso). Usuário padrão: admin@smarkee.internal.ipm-dev.smarkee.com.br
ZITADEL_FIRSTINSTANCE_ORG_HUMAN_PASSWORD=
ZITADEL_FIRSTINSTANCE_ORG_HUMAN_EMAIL=admin@smarkee.internal

# Domínio pelo qual os clientes acessam o Zitadel (o gateway roteia por host).
# Define o issuer/URLs do Zitadel; alterar exige reinicializar a instância.
ZITADEL_EXTERNALDOMAIN=ipm-dev.smarkee.com.br

# Porta pela qual os clientes acessam o Zitadel (porta do proxy HTTP do gateway).
# Define o issuer/URLs do Zitadel; alterar exige reinicializar a instância.
ZITADEL_EXTERNALPORT=8080

# Imagem do login v2 (use a mesma versão do Zitadel).
ZITADEL_LOGIN_IMAGE_VERSION=ghcr.io/zitadel/zitadel-login:v4.19.4

# Obrigatório. Segredo do cookie de sessão do login. Gere com: openssl rand -hex 32
ZITADEL_SESSION_COOKIE_SECRET=
