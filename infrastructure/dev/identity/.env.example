# Imagem do Zitadel
SMARKEE_IDENTITY_IMAGE_VERSION=ghcr.io/zitadel/zitadel:v4.19.4

# Obrigatório. Exatamente 32 caracteres. Gere com: openssl rand -hex 16
# Não altere depois da primeira inicialização (cifra dados em repouso).
SMARKEE_IDENTITY_MASTERKEY=

# Banco de dados (serviço `database`, mesma rede internal)
SMARKEE_IDENTITY_DATABASE_HOST=database.smarkee.internal
SMARKEE_IDENTITY_DATABASE_PORT=5432
SMARKEE_IDENTITY_DATABASE_NAME=identity
SMARKEE_IDENTITY_DATABASE_USER=identity
# Obrigatório. Senha do usuário do Zitadel, criado por database/bootstrap/identity.sql (dev: igual ao nome do usuário).
SMARKEE_IDENTITY_DATABASE_PASSWORD=identity

# Primeira instância: nome exibido no console (forma curta de Identity Provider Manager)
SMARKEE_IDENTITY_INSTANCE_NAME=IPM

# Primeira instância: organização inicial e administrador humano
SMARKEE_IDENTITY_ORG_NAME=smarkee.internal
SMARKEE_IDENTITY_ADMIN_USERNAME=admin
# Obrigatório. Senha inicial do administrador do Zitadel (exige maiúscula, minúscula,
# número e símbolo; troca obrigatória no primeiro acesso). Usuário padrão: admin@smarkee.internal.ipm-dev.smarkee.com.br
SMARKEE_IDENTITY_ADMIN_PASSWORD=
SMARKEE_IDENTITY_ADMIN_EMAIL=admin@smarkee.internal

# Domínio pelo qual os clientes acessam o Zitadel (o gateway roteia por host).
# Define o issuer/URLs do Zitadel; alterar exige reinicializar a instância.
SMARKEE_IDENTITY_EXTERNAL_DOMAIN=ipm-dev.smarkee.com.br

# Porta pela qual os clientes acessam o Zitadel (porta do proxy HTTP do gateway).
# Define o issuer/URLs do Zitadel; alterar exige reinicializar a instância.
SMARKEE_IDENTITY_EXTERNAL_PORT=8080

# Imagem do login v2 (use a mesma versão do Zitadel).
SMARKEE_IDENTITY_LOGIN_IMAGE_VERSION=ghcr.io/zitadel/zitadel-login:v4.19.4

# Obrigatório. Segredo do cookie de sessão do login. Gere com: openssl rand -hex 32
SMARKEE_IDENTITY_SESSION_COOKIE_SECRET=

# Opcionais (têm default no compose.yaml; descomente só para mudar).
# Limite de CPU do Zitadel.
# SMARKEE_IDENTITY_CPUS=1.0
# Limite de memória do Zitadel.
# SMARKEE_IDENTITY_MEMORY=512M
# Limite de CPU da tela de login.
# SMARKEE_IDENTITY_LOGIN_CPUS=0.5
# Limite de memória da tela de login.
# SMARKEE_IDENTITY_LOGIN_MEMORY=512M
# Servidor SMTP dos e-mails do Zitadel (em dev, o mail).
# SMARKEE_IDENTITY_SMTP_HOST=mail.smarkee.internal:1025
# Remetente dos e-mails.
# SMARKEE_IDENTITY_SMTP_FROM=ipm-dev@smarkee.internal
# Nome do remetente.
# SMARKEE_IDENTITY_SMTP_FROMNAME=IPM-DEV
