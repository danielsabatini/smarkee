# telemetry-router: sem variável obrigatória. Copie para .env (fora do git) apenas se quiser mudar um padrão.

# Opcionais (têm default no compose.yaml; descomente só para mudar).
# Imagem do coletor OpenTelemetry (a mesma para agent, router, telemeters e features).
# SMARKEE_TELEMETRY_IMAGE_VERSION=otel/opentelemetry-collector-contrib:0.163.1
# Limite de CPU.
# SMARKEE_TELEMETRY_ROUTER_CPUS=0.5
# Limite de memória.
# SMARKEE_TELEMETRY_ROUTER_MEMORY=256M
