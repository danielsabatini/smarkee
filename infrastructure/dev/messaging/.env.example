# Imagem do NATS
SMARKEE_MESSAGING_IMAGE_VERSION=nats:2.15.0-alpine

# Imagem da CLI `nats` usada pelos contêineres de inicialização dos Streams (messaging-bootstrap-*)
SMARKEE_MESSAGING_CLIENT_IMAGE=smarkee-nats-client:dev

# Configurações de porta do NATS (publicadas apenas em 127.0.0.1)
SMARKEE_MESSAGING_CLIENT_PORT=4222
SMARKEE_MESSAGING_MONITOR_PORT=8222

# Autenticação do cliente (um único usuário em dev, compartilhado pelos serviços)
SMARKEE_MESSAGING_USER=smarkee
# Obrigatório. Gere com: openssl rand -hex 16
SMARKEE_MESSAGING_PASSWORD=
