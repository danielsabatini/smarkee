{
  "name": "ACTION",
  "description": "Trabalho: decis\u00f5es do Reconciler ao Executor, particionadas no servidor (docs/messaging/NATS.md, 6.3 e 7.5; decis\u00e3o 0018)",
  "subjects": [
    "reconciler.action.>"
  ],
  "retention": "workqueue",
  "discard": "new",
  "storage": "file",
  "num_replicas": 1,
  "max_msgs_per_subject": -1,
  "max_msgs": 100000,
  "max_bytes": 1073741824,
  "max_age": 0,
  "max_msg_size": 1048576,
  "max_consumers": -1,
  "duplicate_window": 120000000000,
  "allow_direct": false,
  "subject_transform": {
    "src": "reconciler.action.*.*.*.*",
    "dest": "reconciler.action.{{wildcard(1)}}.{{wildcard(2)}}.{{partition(4,3)}}.{{wildcard(3)}}.{{wildcard(4)}}"
  }
}
