# Configurações do PostgreSQL
SMARKEE_DATABASE_IMAGE_VERSION=postgres:18.6-alpine
SMARKEE_DATABASE_USER=postgres
# Obrigatório. Gere com: openssl rand -hex 16
SMARKEE_DATABASE_PASSWORD=
SMARKEE_DATABASE_NAME=postgres
SMARKEE_DATABASE_PORT=5432

# Opcionais (têm default no compose.yaml; descomente só para mudar).
# Limite de CPU.
# SMARKEE_DATABASE_CPUS=1.0
# Limite de memória.
# SMARKEE_DATABASE_MEMORY=512M
