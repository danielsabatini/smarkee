# Imagem do NATS Broker
NATS_IMAGE_VERSION=nats:2.15.0-alpine

# Configurações de porta do NATS Broker (publicadas apenas em 127.0.0.1)
NATS_CLIENT_PORT=4222
NATS_MONITOR_PORT=8222

# Autenticação do cliente (um único usuário em dev, compartilhado pelos serviços)
NATS_USER=smarkee
# Obrigatório. Gere com: openssl rand -hex 16
NATS_PASSWORD=
