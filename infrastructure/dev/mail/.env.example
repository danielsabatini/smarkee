# mail: sem variável obrigatória. Copie para .env (fora do git) apenas se quiser mudar um padrão.

# Opcionais (têm default no compose.yaml; descomente só para mudar).
# Imagem do servidor de e-mail de desenvolvimento.
# SMARKEE_MAIL_IMAGE_VERSION=axllent/mailpit:v1.31.4
# Porta da interface web (publicada só em 127.0.0.1).
# SMARKEE_MAIL_UI_PORT=8025
# Limite de CPU.
# SMARKEE_MAIL_CPUS=0.25
# Limite de memória.
# SMARKEE_MAIL_MEMORY=256M
