# Imagem do Kong Gateway
KONG_IMAGE_VERSION=kong:3.9.3-ubuntu

# Configurações de porta do Kong Gateway (publicadas apenas em 127.0.0.1)
KONG_PROXY_HTTP_PORT=8080
KONG_PROXY_HTTPS_PORT=8443
KONG_ADMIN_HTTP_PORT=8001
KONG_ADMIN_HTTPS_PORT=8444
KONG_MANAGER_HTTP_PORT=8002
KONG_MANAGER_HTTPS_PORT=8445

# Banco do Kong (serviço `database`, rede internal). Valores triviais, apenas para desenvolvimento local.
KONG_DATABASE_HOST=database.smarkee.internal
KONG_DATABASE_PORT=5432
KONG_DATABASE_NAME=gateway
KONG_DATABASE_USER=gateway
KONG_DATABASE_PASSWORD=gateway
