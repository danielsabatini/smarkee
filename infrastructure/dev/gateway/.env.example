# Imagens do gateway: Apache APISIX, etcd (armazena a configuração) e ADC (aplica bootstrap/adc.yaml)
APISIX_IMAGE_VERSION=apache/apisix:3.19.0-debian
ETCD_IMAGE_VERSION=quay.io/coreos/etcd:v3.7.2
ADC_IMAGE_VERSION=api7/adc:0.31.0

# Portas do gateway (publicadas apenas em 127.0.0.1)
APISIX_PROXY_HTTP_PORT=8080
# Admin API e console web (http://localhost:9180/ui)
APISIX_ADMIN_PORT=9180

# Obrigatório. Chave da Admin API e do console web (você a digita no login do console).
# Gere com: openssl rand -hex 16
APISIX_ADMIN_KEY=

# Destino dos traces do gateway: OTLP HTTP (host:porta). O padrão é o telemetry-router (rede `internal`).
# Para usar um coletor publicado no host: host.docker.internal:4318
APISIX_OTEL_COLLECTOR_ADDRESS=telemetry-router.smarkee.internal:4318

# Audiência de cada API no gateway: ID do projeto de roles do módulo no Zitadel (organização `core`), o mesmo
# `*_AUTH_AUDIENCE` do Receiver correspondente (features/<módulo>/<tipo>/.env). Vazio: a API rejeita todos os tokens.
APISIX_AUTH_AUDIENCE_CORE_ACCOUNT=
APISIX_AUTH_AUDIENCE_IPM_ORGANIZATION=
APISIX_AUTH_AUDIENCE_SUM_SERVICE=

# Proxy (balanceador) em que o gateway confia para ler o IP real do cliente no X-Forwarded-For (um IP ou um CIDR).
# Vazio: loopback, ou seja, não confia em ninguém. Em dev, deixe vazio: o par é o NAT do Docker e confiar nele
# permitiria forjar o cabeçalho. Em stg e prd, o CIDR do balanceador.
APISIX_TRUSTED_PROXIES=
