# Serviço core. Copie para .env (fora do git) e preencha o que está vazio.

# Senhas dos papéis de login do SSOT. Em dev são triviais e iguais ao nome do papel
# (database/bootstrap/core.sql). Em stg e prd, vêm da gestão de segredos.
CORE_DATABASE_ORGANIZATION_MANAGER_PASSWORD=core_organization_manager_login
CORE_DATABASE_ORGANIZATION_API_PASSWORD=core_organization_api_login
CORE_DATABASE_USER_MANAGER_PASSWORD=core_user_manager_login
CORE_DATABASE_USER_API_PASSWORD=core_user_api_login
CORE_DATABASE_RELAY_PASSWORD=core_relay_login

# Obrigatório. A mesma NATS_PASSWORD de broker/.env (em dev, um único usuário no NATS).
CORE_NATS_PASSWORD=

# Obrigatório. ID do projeto `smarkee` (organização `core` do Zitadel): é a audience dos tokens.
CORE_AUTH_AUDIENCE=
